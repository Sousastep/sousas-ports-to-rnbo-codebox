                                    "code": "/* mrelwood_HP-LP_LR4_Filters — RNBO codebox~ port of mrelwood source.\n * Stereo in1/in2 -> out1/out2; original slider units and defaults.\n * Graphics and GUI meters omitted. See RNBO/README.md and VALIDATION.md.\n * //\n * // NO WARRANTY IS GRANTED. THIS PLUG-IN IS PROVIDED ON AN \"AS IS\" BASIS, WITHOUT\n * // WARRANTY OF ANY KIND. NO LIABILITY IS GRANTED, INCLUDING, BUT NOT LIMITED TO,\n * // ANY DIRECT OR INDIRECT,  SPECIAL,  INCIDENTAL OR CONSEQUENTIAL DAMAGE ARISING\n * // OUT OF  THE  USE  OR INABILITY  TO  USE  THIS PLUG-IN,  COMPUTER FAILTURE  OF\n * // MALFUNCTION INCLUDED.  THE USE OF THE SOURCE CODE,  EITHER  PARTIALLY  OR  IN\n * // TOTAL, IS ONLY GRANTED,  IF USED IN THE SENSE OF THE AUTHOR'S INTENTION,  AND\n * // USED WITH ACKNOWLEDGEMENT OF THE AUTHOR. FURTHERMORE IS THIS PLUG-IN A  THIRD\n * // PARTY CONTRIBUTION,  EVEN IF INCLUDED IN REAPER(TM),  COCKOS INCORPORATED  OR\n * // ITS AFFILIATES HAVE NOTHING TO DO WITH IT.  LAST BUT NOT LEAST, BY USING THIS\n * // PLUG-IN YOU RELINQUISH YOUR CLAIM TO SUE IT'S AUTHOR, AS WELL AS THE CLAIM TO\n * // ENTRUST SOMEBODY ELSE WITH DOING SO.\n * // \n * // Released under GPL:\n * // <http://www.gnu.org/licenses/>.\n * //\n * // ******************************************************************************\n * // butterworth filter implementation - \n * // original port from apple.com au tutorial (c+)\n * // added HP version\n * // added 12 poles cascade\n * // * see note below about efficiency\n * // ******************************************************************************\n * \n * desc: HP/LP LR4 Filters  [mrelwood]\n * //tags: filter\n * //author: mrelwood plugins\n * \n * \n */\n// Poles\n@param({ min: 0, max: 5 }) slider2 = 1;\n// -Frequency (Scale)\n@param({ min: 0, max: 1 }) slider3 = .5;\n// -Resonance (dB)\n@param({ min: -6, max: 6 }) slider4 = 0;\n// -LP Polarity\n@param({ min: 0, max: 1 }) slider5 = 0;\n// -HP Polarity\n@param({ min: 0, max: 1 }) slider6 = 0;\n// -Mode\n@param({ min: 0, max: 3 }) slider8 = 0;\n// -Output (dB)\n@param({ min: -24, max: 24 }) slider20 = 0;\n@state s_initialized = 0;\n@state frame: Int = 0;\n@state prepared = 0;\n@state s_Q = 0;\n@state s__tmp = 0;\n@state s_ext_tail_size = 0;\n@state s_freq = 0;\n@state s_hpL = 0;\n@state s_hpR = 0;\n@state s_hp_L1_hp0 = 0;\n@state s_hp_L1_hp1 = 0;\n@state s_hp_L1_hp2 = 0;\n@state s_hp_L1_lp0 = 0;\n@state s_hp_L1_lp1 = 0;\n@state s_hp_L1_lp2 = 0;\n@state s_hp_L1_out = 0;\n@state s_hp_L2_hp0 = 0;\n@state s_hp_L2_hp1 = 0;\n@state s_hp_L2_hp2 = 0;\n@state s_hp_L2_lp0 = 0;\n@state s_hp_L2_lp1 = 0;\n@state s_hp_L2_lp2 = 0;\n@state s_hp_L2_out = 0;\n@state s_hp_L3_hp0 = 0;\n@state s_hp_L3_hp1 = 0;\n@state s_hp_L3_hp2 = 0;\n@state s_hp_L3_lp0 = 0;\n@state s_hp_L3_lp1 = 0;\n@state s_hp_L3_lp2 = 0;\n@state s_hp_L3_out = 0;\n@state s_hp_L4_hp0 = 0;\n@state s_hp_L4_hp1 = 0;\n@state s_hp_L4_hp2 = 0;\n@state s_hp_L4_lp0 = 0;\n@state s_hp_L4_lp1 = 0;\n@state s_hp_L4_lp2 = 0;\n@state s_hp_L4_out = 0;\n@state s_hp_L5_hp0 = 0;\n@state s_hp_L5_hp1 = 0;\n@state s_hp_L5_hp2 = 0;\n@state s_hp_L5_lp0 = 0;\n@state s_hp_L5_lp1 = 0;\n@state s_hp_L5_lp2 = 0;\n@state s_hp_L5_out = 0;\n@state s_hp_L6_hp0 = 0;\n@state s_hp_L6_hp1 = 0;\n@state s_hp_L6_hp2 = 0;\n@state s_hp_L6_lp0 = 0;\n@state s_hp_L6_lp1 = 0;\n@state s_hp_L6_lp2 = 0;\n@state s_hp_L6_out = 0;\n@state s_hp_L7_hp0 = 0;\n@state s_hp_L7_hp1 = 0;\n@state s_hp_L7_hp2 = 0;\n@state s_hp_L7_lp0 = 0;\n@state s_hp_L7_lp1 = 0;\n@state s_hp_L7_lp2 = 0;\n@state s_hp_L7_out = 0;\n@state s_hp_R1_hp0 = 0;\n@state s_hp_R1_hp1 = 0;\n@state s_hp_R1_hp2 = 0;\n@state s_hp_R1_lp0 = 0;\n@state s_hp_R1_lp1 = 0;\n@state s_hp_R1_lp2 = 0;\n@state s_hp_R1_out = 0;\n@state s_hp_R2_hp0 = 0;\n@state s_hp_R2_hp1 = 0;\n@state s_hp_R2_hp2 = 0;\n@state s_hp_R2_lp0 = 0;\n@state s_hp_R2_lp1 = 0;\n@state s_hp_R2_lp2 = 0;\n@state s_hp_R2_out = 0;\n@state s_hp_R3_hp0 = 0;\n@state s_hp_R3_hp1 = 0;\n@state s_hp_R3_hp2 = 0;\n@state s_hp_R3_lp0 = 0;\n@state s_hp_R3_lp1 = 0;\n@state s_hp_R3_lp2 = 0;\n@state s_hp_R3_out = 0;\n@state s_hp_R4_hp0 = 0;\n@state s_hp_R4_hp1 = 0;\n@state s_hp_R4_hp2 = 0;\n@state s_hp_R4_lp0 = 0;\n@state s_hp_R4_lp1 = 0;\n@state s_hp_R4_lp2 = 0;\n@state s_hp_R4_out = 0;\n@state s_hp_R5_hp0 = 0;\n@state s_hp_R5_hp1 = 0;\n@state s_hp_R5_hp2 = 0;\n@state s_hp_R5_lp0 = 0;\n@state s_hp_R5_lp1 = 0;\n@state s_hp_R5_lp2 = 0;\n@state s_hp_R5_out = 0;\n@state s_hp_R6_hp0 = 0;\n@state s_hp_R6_hp1 = 0;\n@state s_hp_R6_hp2 = 0;\n@state s_hp_R6_lp0 = 0;\n@state s_hp_R6_lp1 = 0;\n@state s_hp_R6_lp2 = 0;\n@state s_hp_R6_out = 0;\n@state s_hp_R7_hp0 = 0;\n@state s_hp_R7_hp1 = 0;\n@state s_hp_R7_hp2 = 0;\n@state s_hp_R7_lp0 = 0;\n@state s_hp_R7_lp1 = 0;\n@state s_hp_R7_lp2 = 0;\n@state s_hp_R7_out = 0;\n@state s_hp_a0_hp = 0;\n@state s_hp_a0_lp = 0;\n@state s_hp_a1_hp = 0;\n@state s_hp_a1_lp = 0;\n@state s_hp_a2_hp = 0;\n@state s_hp_a2_lp = 0;\n@state s_hp_alpha = 0;\n@state s_hp_b0_hp = 0;\n@state s_hp_b0_lp = 0;\n@state s_hp_b1_hp = 0;\n@state s_hp_b1_lp = 0;\n@state s_hp_b2_hp = 0;\n@state s_hp_b2_lp = 0;\n@state s_hp_cosw = 0;\n@state s_hp_lphp = 0;\n@state s_hp_sinw = 0;\n@state s_hp_w0 = 0;\n@state s_hpena = 0;\n@state s_hppol = 0;\n@state s_lpL = 0;\n@state s_lpR = 0;\n@state s_lp_L1_hp0 = 0;\n@state s_lp_L1_hp1 = 0;\n@state s_lp_L1_hp2 = 0;\n@state s_lp_L1_lp0 = 0;\n@state s_lp_L1_lp1 = 0;\n@state s_lp_L1_lp2 = 0;\n@state s_lp_L1_out = 0;\n@state s_lp_L2_hp0 = 0;\n@state s_lp_L2_hp1 = 0;\n@state s_lp_L2_hp2 = 0;\n@state s_lp_L2_lp0 = 0;\n@state s_lp_L2_lp1 = 0;\n@state s_lp_L2_lp2 = 0;\n@state s_lp_L2_out = 0;\n@state s_lp_L3_hp0 = 0;\n@state s_lp_L3_hp1 = 0;\n@state s_lp_L3_hp2 = 0;\n@state s_lp_L3_lp0 = 0;\n@state s_lp_L3_lp1 = 0;\n@state s_lp_L3_lp2 = 0;\n@state s_lp_L3_out = 0;\n@state s_lp_L4_hp0 = 0;\n@state s_lp_L4_hp1 = 0;\n@state s_lp_L4_hp2 = 0;\n@state s_lp_L4_lp0 = 0;\n@state s_lp_L4_lp1 = 0;\n@state s_lp_L4_lp2 = 0;\n@state s_lp_L4_out = 0;\n@state s_lp_L5_hp0 = 0;\n@state s_lp_L5_hp1 = 0;\n@state s_lp_L5_hp2 = 0;\n@state s_lp_L5_lp0 = 0;\n@state s_lp_L5_lp1 = 0;\n@state s_lp_L5_lp2 = 0;\n@state s_lp_L5_out = 0;\n@state s_lp_L6_hp0 = 0;\n@state s_lp_L6_hp1 = 0;\n@state s_lp_L6_hp2 = 0;\n@state s_lp_L6_lp0 = 0;\n@state s_lp_L6_lp1 = 0;\n@state s_lp_L6_lp2 = 0;\n@state s_lp_L6_out = 0;\n@state s_lp_L7_hp0 = 0;\n@state s_lp_L7_hp1 = 0;\n@state s_lp_L7_hp2 = 0;\n@state s_lp_L7_lp0 = 0;\n@state s_lp_L7_lp1 = 0;\n@state s_lp_L7_lp2 = 0;\n@state s_lp_L7_out = 0;\n@state s_lp_R1_hp0 = 0;\n@state s_lp_R1_hp1 = 0;\n@state s_lp_R1_hp2 = 0;\n@state s_lp_R1_lp0 = 0;\n@state s_lp_R1_lp1 = 0;\n@state s_lp_R1_lp2 = 0;\n@state s_lp_R1_out = 0;\n@state s_lp_R2_hp0 = 0;\n@state s_lp_R2_hp1 = 0;\n@state s_lp_R2_hp2 = 0;\n@state s_lp_R2_lp0 = 0;\n@state s_lp_R2_lp1 = 0;\n@state s_lp_R2_lp2 = 0;\n@state s_lp_R2_out = 0;\n@state s_lp_R3_hp0 = 0;\n@state s_lp_R3_hp1 = 0;\n@state s_lp_R3_hp2 = 0;\n@state s_lp_R3_lp0 = 0;\n@state s_lp_R3_lp1 = 0;\n@state s_lp_R3_lp2 = 0;\n@state s_lp_R3_out = 0;\n@state s_lp_R4_hp0 = 0;\n@state s_lp_R4_hp1 = 0;\n@state s_lp_R4_hp2 = 0;\n@state s_lp_R4_lp0 = 0;\n@state s_lp_R4_lp1 = 0;\n@state s_lp_R4_lp2 = 0;\n@state s_lp_R4_out = 0;\n@state s_lp_R5_hp0 = 0;\n@state s_lp_R5_hp1 = 0;\n@state s_lp_R5_hp2 = 0;\n@state s_lp_R5_lp0 = 0;\n@state s_lp_R5_lp1 = 0;\n@state s_lp_R5_lp2 = 0;\n@state s_lp_R5_out = 0;\n@state s_lp_R6_hp0 = 0;\n@state s_lp_R6_hp1 = 0;\n@state s_lp_R6_hp2 = 0;\n@state s_lp_R6_lp0 = 0;\n@state s_lp_R6_lp1 = 0;\n@state s_lp_R6_lp2 = 0;\n@state s_lp_R6_out = 0;\n@state s_lp_R7_hp0 = 0;\n@state s_lp_R7_hp1 = 0;\n@state s_lp_R7_hp2 = 0;\n@state s_lp_R7_lp0 = 0;\n@state s_lp_R7_lp1 = 0;\n@state s_lp_R7_lp2 = 0;\n@state s_lp_R7_out = 0;\n@state s_lp_a0_hp = 0;\n@state s_lp_a0_lp = 0;\n@state s_lp_a1_hp = 0;\n@state s_lp_a1_lp = 0;\n@state s_lp_a2_hp = 0;\n@state s_lp_a2_lp = 0;\n@state s_lp_alpha = 0;\n@state s_lp_b0_hp = 0;\n@state s_lp_b0_lp = 0;\n@state s_lp_b1_hp = 0;\n@state s_lp_b1_lp = 0;\n@state s_lp_b2_hp = 0;\n@state s_lp_b2_lp = 0;\n@state s_lp_cosw = 0;\n@state s_lp_lphp = 0;\n@state s_lp_sinw = 0;\n@state s_lp_w0 = 0;\n@state s_lpena = 0;\n@state s_lpfmul = 0;\n@state s_lppol = 0;\n@state s_mode = 0;\n@state s_poles = 0;\n@state s_reso = 0;\n@state s_spl0 = 0;\n@state s_spl1 = 0;\n@state s_spl2 = 0;\n@state s_spl3 = 0;\n@state s_vol = 0;\n@state s_xover = 0;\n// EEL division by zero returns zero; RNBO arithmetic does not.\nfunction eelDivide(a,b) { return b == 0 ? 0 : a/b; }\nfunction fn__upsli() {\ns_poles = (slider2 + 1);\nlet tmp3 = 0;\nif (slider3 < .5) {\ns_freq = pow(10,(1.3 + (slider3 * 3.4)));\ntmp3 = s_freq;\n} else {\nlet tmp1 = 0;\nlet tmp2 = (slider3 - .5);\ns_freq = pow(10,(3 + (maximum(tmp1, tmp2) * 2.62)));\ntmp3 = s_freq;\n}\nlet tmp4 = 20;\nlet tmp5 = 20000;\nlet tmp6 = s_freq;\nlet tmp7 = minimum(tmp5, tmp6);\ns_freq = maximum(tmp4, tmp7);\ns_lpfmul = 1;\ns_reso = slider4;\ns_lppol = (1 - (slider5 * 2));\ns_hppol = (1 - (slider6 * 2));\ns_mode = slider8;\nlet tmp17 = 0;\nif (s_poles == 1) {\nlet tmp8 = 0;\nif (s_mode == 3) {\ns_hppol *= (0 - 1);\ntmp8 = s_hppol;\n} else {\ntmp8 = 0;\n}\nlet tmp9 = 0;\nif (s_reso > 0) {\ns_reso *= 2;\ntmp9 = s_reso;\n} else {\ntmp9 = 0;\n}\ns_reso -= 6;\ntmp17 = s_reso;\n} else {\nlet tmp16 = 0;\nif (s_poles == 2) {\ns_reso -= 3;\ntmp16 = s_reso;\n} else {\nlet tmp15 = 0;\nif (s_poles == 3) {\ns_lpfmul = 1.24;\nlet tmp10 = 0;\nif (s_mode == 3) {\ns_hppol *= (0 - 1);\ntmp10 = s_hppol;\n} else {\ntmp10 = 0;\n}\nlet tmp11 = 0;\nif (s_reso > 0) {\ns_reso *= .6;\ntmp11 = s_reso;\n} else {\ntmp11 = 0;\n}\ns_reso -= 2.8;\ntmp15 = s_reso;\n} else {\nlet tmp14 = 0;\nif (s_poles == 4) {\ns_lpfmul = 1.45;\nlet tmp12 = 0;\nif (s_mode == 3) {\ns_hppol *= (0 - 1);\ntmp12 = s_hppol;\n} else {\ntmp12 = 0;\n}\nlet tmp13 = 0;\nif (s_reso > 0) {\ns_reso *= .4;\ntmp13 = s_reso;\n} else {\ntmp13 = 0;\n}\ns_reso -= 2.9;\ntmp14 = s_reso;\n} else {\ntmp14 = 0;\n}\ntmp15 = tmp14;\n}\ntmp16 = tmp15;\n}\ntmp17 = tmp16;\n}\ns_vol = pow(2,eelDivide(slide