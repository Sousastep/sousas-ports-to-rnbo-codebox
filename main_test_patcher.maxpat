305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state pointDerez = 0;\n@state bypassPre = 0;\n@state X = 0;\n@state dpT: Int = 0;\n@state dpQ: Int = 0;\n@state dpR: Int = 0;\n@state dpS: Int = 0;\n@state bypassVerb = 0;\n@state damping = 0;\n@state unSolid: Int = 0;\n@state unReflect: Int = 0;\n@state wet = 0;\n@state distance = 0;\n@state distanceSteps: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\n// RNBO has no fused multiply-add operator; preserve the equation.\nfunction multiplyAdd(a, b, c) { return a * b + c; }\n\n@state floatCast = new FixedFloat32Array(1);\nfunction asFloat32(x) { floatCast[0] = x; return floatCast[0]; }\n\nfunction init() {\n\n\tfor(let x: Int = 0; x < d4A+2; x++) {lA[x] = 0.0; rA[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4B+2; x++) {lB[x] = 0.0; rB[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4C+2; x++) {lC[x] = 0.0; rC[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4D+2; x++) {lD[x] = 0.0; rD[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4E+2; x++) {lE[x] = 0.0; rE[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4F+2; x++) {lF[x] = 0.0; rF[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4G+2; x++) {lG[x] = 0.0; rG[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4H+2; x++) {lH[x] = 0.0; rH[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4I+2; x++) {lI[x] = 0.0; rI[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4J+2; x++) {lJ[x] = 0.0; rJ[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4K+2; x++) {lK[x] = 0.0; rK[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4L+2; x++) {lL[x] = 0.0; rL[x