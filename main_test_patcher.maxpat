                        "boxes": [
                            {
                                "box": {
                                    "code": "/* VerbThic — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Replace\n@param({ min: 0, max: 1 }) p_replace = 0.5;\n// VST B: Derez\n@param({ min: 0, max: 1 }) p_derez = 1.0;\n// VST C: Filter\n@param({ min: 0, max: 1 }) p_filter = 1.0;\n// VST D: Wider\n@param({ min: 0, max: 1 }) p_wider = 0.0;\n// VST E: Dry/Wet\n@param({ min: 0, max: 1 }) p_drywet = 1.0;\n\nconst d4A = 1439;\nconst d4B = 3;\nconst d4C = 259;\nconst d4D = 578;\nconst d4E = 1562;\nconst d4F = 1152;\nconst d4G = 189;\nconst d4H = 3;\nconst d4I = 9;\nconst d4J = 101;\nconst d4K = 34;\nconst d4L = 638;\nconst d4M = 719;\nconst d4N = 1154;\nconst d4O = 38;\nconst d4P = 530;\nconst bez_AL = 0;\nconst bez_AR = 1;\nconst bez_BL = 2;\nconst bez_BR = 3;\nconst bez_CL = 4;\nconst bez_CR = 5;\nconst bez_SampL = 6;\nconst bez_SampR = 7;\nconst bez_cycle = 8;\nconst bez_total = 9;\n@state a4AL = new FixedFloat64Array(d4A+5);\n@state a4BL = new FixedFloat64Array(d4B+5);\n@state a4CL = new FixedFloat64Array(d4C+5);\n@state a4DL = new FixedFloat64Array(d4D+5);\n@state a4EL = new FixedFloat64Array(d4E+5);\n@state a4FL = new FixedFloat64Array(d4F+5);\n@state a4GL = new FixedFloat64Array(d4G+5);\n@state a4HL = new FixedFloat64Array(d4H+5);\n@state a4IL = new FixedFloat64Array(d4I+5);\n@state a4JL = new FixedFloat64Array(d4J+5);\n@state a4KL = new FixedFloat64Array(d4K+5);\n@state a4LL = new FixedFloat64Array(d4L+5);\n@state a4ML = new FixedFloat64Array(d4M+5);\n@state a4NL = new FixedFloat64Array(d4N+5);\n@state a4OL = new FixedFloat64Array(d4O+5);\n@state a4PL = new FixedFloat64Array(d4P+5);\n@state a4AR = new FixedFloat64Array(d4A+5);\n@state a4BR = new FixedFloat64Array(d4B+5);\n@state a4CR = new FixedFloat64Array(d4C+5);\n@state a4DR = new FixedFloat64Array(d4D+5);\n@state a4ER = new FixedFloat64Array(d4E+5);\n@state a4FR = new FixedFloat64Array(d4F+5);\n@state a4GR = new FixedFloat64Array(d4G+5);\n@state a4HR = new FixedFloat64Array(d4H+5);\n@state a4IR = new FixedFloat64Array(d4I+5);\n@state a4JR = new FixedFloat64Array(d4J+5);\n@state a4KR = new FixedFloat64Array(d4K+5);\n@state a4LR = new FixedFloat64Array(d4L+5);\n@state a4MR = new FixedFloat64Array(d4M+5);\n@state a4NR = new FixedFloat64Array(d4N+5);\n@state a4OR = new FixedFloat64Array(d4O+5);\n@state a4PR = new FixedFloat64Array(d4P+5);\n@state c4AL: Int = 0;\n@state c4BL: Int = 0;\n@state c4CL: Int = 0;\n@state c4DL: Int = 0;\n@state c4EL: Int = 0;\n@state c4FL: Int = 0;\n@state c4GL: Int = 0;\n@state c4HL: Int = 0;\n@state c4IL: Int = 0;\n@state c4JL: Int = 0;\n@state c4KL: Int = 0;\n@state c4LL: Int = 0;\n@state c4ML: Int = 0;\n@state c4NL: Int = 0;\n@state c4OL: Int = 0;\n@state c4PL: Int = 0;\n@state c4AR: Int = 0;\n@state c4BR: Int = 0;\n@state c4CR: Int = 0;\n@state c4DR: Int = 0;\n@state c4ER: Int = 0;\n@state c4FR: Int = 0;\n@state c4GR: Int = 0;\n@state c4HR: Int = 0;\n@state c4IR: Int = 0;\n@state c4JR: Int = 0;\n@state c4KR: Int = 0;\n@state c4LR: Int = 0;\n@state c4MR: Int = 0;\n@state c4NR: Int = 0;\n@state c4OR: Int = 0;\n@state c4PR: Int = 0;\n@state f4AL = 0;\n@state f4BL = 0;\n@state f4CL = 0;\n@state f4DL = 0;\n@state f4DR = 0;\n@state f4HR = 0;\n@state f4LR = 0;\n@state f4PR = 0;\n@state b4AL = new FixedFloat64Array(d4A+5);\n@state b4BL = new FixedFloat64Array(d4B+5);\n@state b4CL = new FixedFloat64Array(d4C+5);\n@state b4DL = new FixedFloat64Array(d4D+5);\n@state b4EL = new FixedFloat64Array(d4E+5);\n@state b4FL = new FixedFloat64Array(d4F+5);\n@state b4GL = new FixedFloat64Array(d4G+5);\n@state b4HL = new FixedFloat64Array(d4H+5);\n@state b4IL = new FixedFloat64Array(d4I+5);\n@state b4JL = new FixedFloat64Array(d4J+5);\n@state b4KL = new FixedFloat64Array(d4K+5);\n@state b4LL = new FixedFloat64Array(d4L+5);\n@state b4ML = new FixedFloat64Array(d4M+5);\n@state b4NL = new FixedFloat64Array(d4N+5);\n@state b4OL = new FixedFloat64Array(d4O+5);\n@state b4PL = new FixedFloat64Array(d4P+5);\n@state b4AR = new FixedFloat64Array(d4A+5);\n@state b4BR = new FixedFloat64Array(d4B+5);\n@state b4CR = new FixedFloat64Array(d4C+5);\n@state b4DR = new FixedFloat64Array(d4D+5);\n@state b4ER = new FixedFloat64Array(d4E+5);\n@state b4FR = new FixedFloat64Array(d4F+5);\n@state b4GR = new FixedFloat64Array(d4G+5);\n@state b4HR = new FixedFloat64Array(d4H+5);\n@state b4IR = new FixedFloat64Array(d4I+5);\n@state b4JR = new FixedFloat64Array(d4J+5);\n@state b4KR = new FixedFloat64Array(d4K+5);\n@state b4LR = new FixedFloat64Array(d4L+5);\n@state b4MR = new FixedFloat64Array(d4M+5);\n@state b4NR = new FixedFloat64Array(d4N+5);\n@state b4OR = new FixedFloat64Array(d4O+5);\n@state b4PR = new FixedFloat64Array(d4P+5);\n@state g4AL = 0;\n@state g4BL = 0;\n@state g4CL = 0;\n@state g4DL = 0;\n@state g4DR = 0;\n@state g4HR = 0;\n@state g4LR = 0;\n@state g4PR = 0;\n@state bez = new FixedFloat64Array(bez_total);\n@state bezF = new FixedFloat64Array(bez_total);\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state reg4n = 0;\n@state attenuate = 0;\n@state derez = 0;\n@state bezFraction: Int = 0;\n@state bezTrim = 0;\n@state derezFreq = 0;\n@state bezFreqFraction: Int = 0;\n@state bezFreqTrim = 0;\n@state wider = 0;\n@state wet = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor(let x: Int = 0; x < d4A+2; x++) {a4AL[x] = 0.0; a4AR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4B+2; x++) {a4BL[x] = 0.0; a4BR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4C+2; x++) {a4CL[x] = 0.0; a4CR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4D+2; x++) {a4DL[x] = 0.0; a4DR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4E+2; x++) {a4EL[x] = 0.0; a4ER[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4F+2; x++) {a4FL[x] = 0.0; a4FR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4G+2; x++) {a4GL[x] = 0.0; a4GR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4H+2; x++) {a4HL[x] = 0.0; a4HR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4I+2; x++) {a4IL[x] = 0.0; a4IR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4J+2; x++) {a4JL[x] = 0.0; a4JR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4K+2; x++) {a4KL[x] = 0.0; a4KR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4L+2; x++) {a4LL[x] = 0.0;