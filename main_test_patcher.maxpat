                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "/* TakeCare — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Speed\n@param({ min: 0, max: 1 }) p_speed = 0.15;\n// VST B: Rando\n@param({ min: 0, max: 1 }) p_rando = 0.5;\n// VST C: Depth\n@param({ min: 0, max: 1 }) p_depth = 0.5;\n// VST D: Regen\n@param({ min: 0, max: 1 }) p_regen = 0.5;\n// VST E: Derez\n@param({ min: 0, max: 1 }) p_derez = 0.5;\n// VST F: Buffer\n@param({ min: 0, max: 1 }) p_buffer = 0.5;\n// VST G: Output\n@param({ min: 0, max: 1 }) p_output = 1.0;\n// VST H: Dry/Wet\n@param({ min: 0, max: 1 }) p_drywet = 1.0;\n\nconst bez_AL = 0;\nconst bez_AR = 1;\nconst bez_BL = 2;\nconst bez_BR = 3;\nconst bez_CL = 4;\nconst bez_CR = 5;\nconst bez_InL = 6;\nconst bez_InR = 7;\nconst bez_UnInL = 8;\nconst bez_UnInR = 9;\nconst bez_SampL = 10;\nconst bez_SampR = 11;\nconst bez_AvgInSampL = 12;\nconst bez_AvgInSampR = 13;\nconst bez_AvgOutSampL = 14;\nconst bez_AvgOutSampR = 15;\nconst bez_cycle = 16;\nconst bez_total = 17;\n@state a3AL = new FixedFloat64Array(32767+5);\n@state a3BL = new FixedFloat64Array(32767+5);\n@state a3CL = new FixedFloat64Array(32767+5);\n@state a3DL = new FixedFloat64Array(32767+5);\n@state a3EL = new FixedFloat64Array(32767+5);\n@state a3FL = new FixedFloat64Array(32767+5);\n@state a3GL = new FixedFloat64Array(32767+5);\n@state a3HL = new FixedFloat64Array(32767+5);\n@state a3IL = new FixedFloat64Array(32767+5);\n@state a3AR = new FixedFloat64Array(32767+5);\n@state a3BR = new FixedFloat64Array(32767+5);\n@state a3CR = new FixedFloat64Array(32767+5);\n@state a3DR = new FixedFloat64Array(32767+5);\n@state a3ER = new FixedFloat64Array(32767+5);\n@state a3FR = new FixedFloat64Array(32767+5);\n@state a3GR = new FixedFloat64Array(32767+5);\n@state a3HR = new FixedFloat64Array(32767+5);\n@state a3IR = new FixedFloat64Array(32767+5);\n@state c3AL: Int = 0;\n@state c3AR: Int = 0;\n@state c3BL: Int = 0;\n@state c3BR: Int = 0;\n@state c3CL: Int = 0;\n@state c3CR: Int = 0;\n@state c3DL: Int = 0;\n@state c3DR: Int = 0;\n@state c3EL: Int = 0;\n@state c3ER: Int = 0;\n@state c3FL: Int = 0;\n@state c3FR: Int = 0;\n@state c3GL: Int = 0;\n@state c3GR: Int = 0;\n@state c3HL: Int = 0;\n@state c3HR: Int = 0;\n@state c3IL: Int = 0;\n@state c3IR: Int = 0;\n@state f3AL = 0;\n@state f3BL = 0;\n@state f3CL = 0;\n@state f3CR = 0;\n@state f3FR = 0;\n@state f3IR = 0;\n@state avg3L = 0;\n@state avg3R = 0;\n@state bez = new FixedFloat64Array(bez_total);\n@state rotate = 0;\n@state oldfpd = 0;\n@state buf: Int = 0;\n@state vibDepth = 0;\n@state derezA = 0;\n@state derezB = 0;\n@state outA = 0;\n@state outB = 0;\n@state wetA = 0;\n@state wetB = 0;\n@state lastSampleL = 0;\n@state wasPosClipL = 0;\n@state wasNegClipL = 0;\n@state lastSampleR = 0;\n@state wasPosClipR = 0;\n@state wasNegClipR = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state spacing: Int = 0;\n@state vibSpeed = 0;\n@state vibRandom = 0;\n@state targetDepth = 0;\n@state reg3n = 0;\n@state stepped = 0;\n@state bezFraction: Int = 0;\n@state bezTrim = 0;\n@state targetBuf: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3AL[x] = 0.0; a3AR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3BL[x] = 0.0; a3BR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3CL[x] = 0.0; a3CR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3DL[x] = 0.0; a3DR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3EL[x] = 0.0; a3ER[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3FL[x] = 0.0; a3FR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3GL[x] = 0.0; a3GR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3HL[x] = 0.0; a3HR[x] = 0.0;}\n\tfor(let x: Int = 0; x < 32767+2; x++) {a3IL[x] = 0.0; a3IR[x] = 0.0;}\n\tc3AL = c3BL = c3CL = c3DL = c3EL = c3FL = c3GL = c3HL = c3IL = 1;\n\tc3AR = c3BR = c3CR = c3DR = c3ER = c3FR = c3GR = c3HR = c3IR = 1;\n\tf3AL = f3BL = f3CL = 0.0;\n\tf3CR = f3FR = f3IR = 0.0;\n\tavg3L = avg3R = 0.0;\n\t\n\tfor (let x: Int = 0; x < bez_total; x++) bez[x] = 0.0;\n\tbez[bez_cycle] = 1.0;\n\t\n\trotate = 0.0;\n\toldfpd = 0.4294967295;\n\t\n\tbuf = 8192;\n\tvibDepth = 0.0;\n\toutA = 1.0;\n\toutB = 1.0;\n\twetA = 1.0;\n\twetB = 1.0;\n\tderezA = 0.5;\n\tderezB = 0.5;\n\t\n\tlastSampleL = 0.0;\n\twasPosClipL = 0;\n\twasNegClipL = 0;\n\tlastSampleR = 0.0;\n\twasPosClipR = 0;\n\twasNegClipR = 0;\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\tspacing = floor(overallscale); \n\tif (spacing < 1) spacing = 1; if (spacing > 16) spacing = 16;\n\tvibSpeed = pow(p_speed,5.0) * 0.1;\n\tvibRandom = pow(p_rando,3.0) * 0.99;\n\ttargetDepth = pow(p_depth,2.0) * 0.5;\n\treg3n = p_regen*0.0625;\n\t\n\tderezA = derezB; derezB = p_derez*2.0;\n\tstepped = 1; \n\tif (derezB > 1.0) {  \n\t\tstepped = 0; \n\t\tderezB = 1.0-(derezB-1.0);\n\t} \n\tderezB = minimum(maximum(derezB/overallscale,0.0005),1.0);\n\tbezFraction = toIndex(1.0/derezB);\n\tbezTrim = bezFraction/(bezFraction+1.0);\n\tif (stepped) { \n\t\tderezB = 1.0 / bezFraction;\n\t\tbezTrim = 1.0-(derezB*bezTrim);\n\t} else { \n\t\tderezB /= (2.0/pow(overallscale,0.5-((overallscale-1.0)*0.0375)));\n\t\tbezTrim = 1.0-pow(derezB*0.5,1.0/(derezB*0.5));\n\t} \n\t\n\ttargetBuf = (pow(p_buffer,3.0)*32510.0)+256;\n\toutA = outB; outB = p_output;\n\twetA = wetB; wetB = 1.0-pow(1.0-p_drywet,2.0);\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\tlet drySampleL = inputSampleL;\n\t\tlet drySampleR = inputSampleR;\n\t\tlet temp = sampleFrames/inFramesToProcess;\n\t\tlet derez = (derezA*temp)+(derezB*(1.0-temp));\n\t\tlet out = (outA*temp)+(outB*(1.0-temp));\n\t\tlet wet = (wetA*temp)+(wetB*(1.0-temp));\n\t\t\n\t\tbez[bez_cycle] += derez;\n\t\tbez[bez_SampL] += ((inputSampleL+bez[bez_InL]) * derez);\n\t\tbez[bez_SampR] += ((inputSampleR+bez[bez_InR]) * derez);\n\t\tbez[bez_InL] = inputSampleL; bez[bez_InR] = inputSampleR;\n\t\tif (bez[bez_cycle] > 1.0) { \n\t\t\tif (stepped) bez[bez_cycle] = 0.0;\n\t\t\telse bez[bez_cycle] -= 1.0;\n\t\t\t\n\t\t\tinputSampleL = (bez[bez_SampL]+bez[bez_AvgInSampL])*0.5;\n\t\t\tbez[bez_AvgInSampL] = bez[bez_SampL];\n\t\t\tinputSampleR = (bez[bez_SampR]+bez[bez_AvgInSampR])*0.5;\n\t\t\tbez[bez_AvgInSampR] = bez[bez_SampR];\n\t\t\t\n\t\t\trotate += (oldfpd*vibSpeed);\n\t\t\tif (rotate > (PI*2.0)) {\n\t\t\t\trotate -= (PI*2.0);\n\t\t\t\toldfpd = (1.0-vibRandom) + ((fpdL*0.000000000618)*vibRandom);\n\t\t\t}\n\t\t\tvibDepth = (vibDepth*0.99)+(targetDepth*0.01);\n\t\t\tif (buf < targetBuf) buf++;\n\t\t\tif (buf > targetBuf) buf--;\n\t\t\t\n\t\t\tlet mA = (sin(rotate)+1.0)*vibDepth*buf;\n\t\t\tlet mB = (sin(rotate+(PI/9.0))+1.0)*vibDepth*buf;\n\t\t\tlet mC = (sin(rotate+((PI/9.0)*2.0))+1.0)*vibDepth*buf;\n\t\t\tlet mD = (sin(rotate+((PI/9.0)*3.0))+1.0)*vibDepth*buf;\n\t\t\tlet mE = (sin(rotate+((PI/9.0)*4.0))+1.0)*vibDepth*buf;\n\t\t\tlet mF = (sin(rotate+((PI/9.0)*5.0))+1.0)*vibDepth*buf;\n\t\t\tlet mG = (sin(rotate+((PI/9.0)*6.0))+1.0)*vibDepth*buf;\n\t\t\tlet mH = (sin(rotate+((PI/9.0)*7.0))+1.0)*vibDepth*buf;\n\t\t\tlet mI = (sin(rotate+((PI/9.0)*8.0))+1.0)*vibDepth*buf;\t\t\n\t\t\t\n\t\t\tinputSampleL = sin(minimum(maximum(inputSampleL*0.5,-(PI*0.5)),(PI*0.5)));\n\t\t\tinputSampleR = sin(minimum(maximum(inputSampleR*0.5,-(PI*0.5)),(PI*0.5)));\n\t\t\t\n\t\t\ta3AL[c3AL] = inputSampleL + minimum(maximum(f3AL*reg3n,-PI),PI);\n\t\t\ta3BL[c3BL] = inputSampleL + minimum(maximum(f3BL*reg3n,-PI),PI);\n\t\t\ta3CL[c3CL] = inputSampleL + minimum(maximum(f3CL*reg3n,-PI),PI);\n\t\t\t\n\t\t\ta3CR[c3CR] = inputSampleR + minimum(maximum(f3CR*reg3n,-PI),PI);\n\t\t\ta3FR[c3FR] = inputSampleR + minimum(maximum(f3FR*reg3n,-PI),PI);\n\t\t\ta3IR[c3IR] = inputSampleR + minimum(maximum(f3IR*reg3n,-PI),PI);\n\t\t\t\n\t\t\tc3AL++; if (c3AL < 0 || c3AL > buf) c3AL = 0;\n\t\t\tc3BL++; if (c3BL < 0 || c3BL > buf) c3BL = 0;\n\t\t\tc3CL++; if (c3CL < 0 || c3CL > buf) c3CL = 0;\n\t\t\tc3CR++; if (c3CR < 0 || c3CR > buf) c3CR = 0;\n\t\t\tc3FR++; if (c3FR < 0 || c3FR > buf) c3FR = 0;\n\t\t\tc3IR++; if (c3IR < 0 || c3IR > buf) c3IR = 0;\n\t\t\t\nlet readIndex1: Int = trunc(c3AL+mA-((c3AL+mA>buf)?buf+1:0));\n\t\t\tlet o3AL = a3AL[readIndex1] *(1.0-(mA-floor(mA)));\nlet readIndex2: Int = trunc(c3AL+mA+1-((c3AL+mA+1>buf)?buf+1:0));\n\t\t\to3AL += (a3AL[readIndex2] *((mA-floor(mA))));\nlet readIndex3: Int = trunc(c3BL+mB-((c3BL+mB>buf)?buf+1:0));\n\t\t\tlet o3BL = a3BL[readIndex3] *(1.0-(mB-floor(mB)));\nlet readIndex4: Int = trunc(c3BL+mB+1-((c3BL+mB+1>buf)?buf+1:0));\n\t\t\to3BL += (a3BL[readIndex4] *((mB-floor(mB))));\nlet readIndex5: Int = trunc(c3CL+mC-((c3CL+mC>buf)?buf+1:0));\n\t\t\tlet o3CL = a3CL[readIndex5] *(1.0-(mC-floor(mC)));\nlet readIndex6: Int = trunc(c3CL+mC+1-((c3CL+mC+1>buf)?buf+1:0));\n\t\t\to3CL += (a3CL[readIndex6] *((mC-floor(mC))));\nlet readIndex7: Int = trunc(c3CR+mC-((c3CR+mC>buf)?buf+1:0));\n\t\t\tlet o3CR = a3CR[readIndex7] *(1.0-(mC-floor(mC)));\nlet readIndex8: Int = trunc(c3CR+mC+1-((c3CR+mC+1>buf)?buf+1:0));\n\t\t\to3CR += (a3CR[readIndex8] *((mC-floor(mC))));\nlet readIndex9: Int = trunc(c3FR+mF-((c3FR+mF>buf)?buf+1:0));\n\t\t\tlet o3FR = a3FR[readIndex9] *(1.0-(mF-floor(mF)));\nlet readIndex10: Int = trunc(c3FR+mF+1-((c3FR+mF+1>buf)?buf+1:0));\n\t\t\to3FR += (a3FR[readIndex10] *((mF-floor(mF))));\nlet readIndex11: Int = trunc(c3IR+mI-((c3IR+mI>buf)?buf+1:0));\n\t\t\tlet o3IR = a3IR[readIndex11] *(1.0-(mI-floor(mI)));\nlet readIndex12: Int = trunc(c3IR+mI+1-((c3IR+mI+1>buf)?buf+1:0));\n\t\t\to3IR += (a3IR[readIndex12] *((mI-floor(mI))));\n\t\t\t\n\t\t\ta3DL[c3DL] = (((o3BL + o3CL) * -2.0) + o3AL);\n\t\t\ta3EL[c3EL] = (((o3AL + o3CL) * -2.0) + o3BL);\n\t\t\ta3FL[c3FL] = (((o3AL + o3BL) * -2.0) + o3CL);\n\t\t\ta3BR[c3BR] = (((o3FR + o3IR) * -2.0) + o3CR);\n\t\t\ta3ER[c3ER] = (((o3CR + o3IR) * -2.0) + o3FR);\n\t\t\ta3HR[c3HR] = (((o3CR + o3FR) * -2.0) + o3IR);\n\t\t\t\n\t\t\tc3DL++; if (c3DL < 0 || c3DL > buf) c3DL = 0;\n\t\t\tc3EL++; if (c3EL < 0 || c3EL > buf) c3EL = 0;\n\t\t\tc3FL++; if (c3FL < 0 || c3FL > buf) c3FL = 0;\n\t\t\tc3BR++; if (c3BR < 0 || c3BR > buf) c3BR = 0;\n\t\t\tc3ER++; if (c3ER < 0 || c3ER > buf) c3ER = 0;\n\t\t\tc3HR++; if (c3HR < 0 || c3HR > buf) c3HR = 0;\n\t\t\t\nlet readIndex13: Int = trunc(c3DL+mD-((c3DL+mD>buf)?buf+1:0));\n\t\t\tlet o3DL = a3DL[readIndex13] *(1.0-(mD-floor(mD)));\nlet readIndex14: Int = trunc(c3DL+mD+1-((c3DL+mD+1>buf)?buf+1:0));\n\t\t\to3DL += (a3DL[readIndex14] *((mD-floor(mD))));\nlet readIndex15: Int = trunc(c3EL+mE-((c3EL+mE>buf)?buf+1:0));\n\t\t\tlet o3EL = a3EL[readIndex15] *(1.0-(mE-floor(mE)));\nlet readIndex16: Int = trunc(c3EL+mE+1-((c3EL+mE+1>buf)?buf+1:0));\n\t\t\to3EL += (a3EL[readIndex16] *((mE-floor(mE))));\nlet readIndex17: Int = trunc(c3FL+mF-((c3FL+mF>buf)?buf+1:0));\n\t\t\tlet o3FL = a3FL[readIndex17] *(1.0-(mF-floor(mF)));\nlet readIndex18: Int = trunc(c3FL+mF+1-((c3FL+mF+1>buf)?buf+1:0));\n\t\t\to3FL += (a3FL[readIndex18] *((mF-floor(mF))));\nlet readIndex19: Int = trunc(c3BR+mB-((c3BR+mB>buf)?buf+1:0));\n\t\t\tlet o3BR = a3BR[readIndex19] *(1.0-(mB-floor(mB)));\nlet readIndex20: Int = trunc(c3BR+mB+1-((c3BR+mB+1>buf)?buf+1:0));\n\t\t\to3BR += (a3BR[readIndex20] *((mB-floor(mB))));\nlet readIndex21: Int = trunc(c3ER+mE-((c3ER+mE>buf)?buf+1:0));\n\t\t\tlet o3ER = a3ER[readIndex21] *(1.0-(mE-floor(mE)));\nlet readIndex22: Int = trunc(c3ER+mE+1-((c3ER+mE+1>buf)?buf+1:0));\n\t\t\to3ER += (a3ER[readIndex22] *((mE-floor(mE))));\nlet readIndex23: Int = trunc(c3HR+mH-((c3HR+mH>buf)?buf+1:0));\n\t\t\tlet o3HR = a3HR[readIndex23] *(1.0-(mH-floor(mH)));\nlet readIndex24: Int = trunc(c3HR+mH+1-((c3HR+mH+1>buf)?buf+1:0));\n\t\t\to3HR += (a3HR[readIndex24] *((mH-floor(mH))));\n\t\t\t\n\t\t\ta3GL[c3GL] = (((o3EL + o3FL) * -2.0) + o3DL);\n\t\t\ta3HL[c3HL] = (((o3DL + o3FL) * -2.0) + o3EL);\n\t\t\ta3IL[c3IL] = (((o3DL + o3EL) * -2.0) + o3FL);\n\t\t\ta3AR[c3AR] = (((o3ER + o3HR) * -2.0) + o3BR);\n\t\t\ta3DR[c3DR] = (((o3BR + o3HR) * -2.0) + o3ER);\n\t\t\ta3GR[c3GR] = (((o3BR + o3ER) * -2.0) + o3HR);\n\n\t\t\tc3GL++; if (c3GL < 0 || c3GL > buf) c3GL = 0;\n\t\t\tc3HL++; if (c3HL < 0 || c3HL > buf) c3HL = 0;\n\t\t\tc3IL++; if (c3IL < 0 || c3IL > buf) c3IL = 0;\n\t\t\tc3AR++; if (c3AR < 0 || c3AR > buf) c3AR = 0;\n\t\t\tc3DR++; if (c3DR < 0 || c3DR > buf) c3DR = 0;\n\t\t\tc3GR++; if (c3GR < 0 || c3GR > buf) c3GR = 0;\n\t\t\t\nlet readIndex25: Int = trunc(c3GL+mG-((c3GL+mG>buf)?buf+1:0));\n\t\t\tlet o3GL = a3GL[readIndex25] *(1.0-(mG-floor(mG)));\nlet readIndex26: Int = trunc(c3GL+mG+1-((c3GL+mG+1>buf)?buf+1:0));\n\t\t\to3GL += (a3GL[readIndex26] *((mG-floor(mG))));\nlet readIndex27: Int = trunc(c3HL+mH-((c3HL+mH>buf)?buf+1:0));\n\t\t\tlet o3HL = a3HL[readIndex27] *(1.0-(mH-floor(mH)));\nlet readIndex28: Int = trunc(c3HL+mH+1-((c3HL+mH+1>buf)?buf+1:0));\n\t\t\to3HL += (a3HL[readIndex28] *((mH-floor(mH))));\nlet readIndex29: Int = trunc(c3IL+mI-((c3IL+mI>buf)?buf+1:0));\n\t\t\tlet o3IL = a3IL[readIndex29] *(1.0-(mI-floor(mI)));\nlet readIndex30: Int = trunc(c3IL+mI+1-((c3IL+mI+1>buf)?buf+1:0));\n\t\t\to3IL += (a3IL[readIndex30] *((mI-floor(mI))));\nlet readIndex31: Int = trunc(c3AR+mA-((c3AR+mA>buf)?buf+1:0));\n\t\t\tlet o3AR = a3AR[readIndex31] *(1.0-(mA-floor(mA)));\nlet readIndex32: Int = trunc(c3AR+mA+1-((c3AR+mA+1>buf)?buf+1:0));\n\t\t\to3AR += (a3AR[readIndex32] *((mA-floor(mA))));\nlet readIndex33: Int = trunc(c3DR+mD-((c3DR+mD>buf)?buf+1:0));\n\t\t\tlet o3DR = a3DR[readIndex33] *(1.0-(mD-floor(mD)));\nlet readIndex34: Int = trunc(c3DR+mD+1-((c3DR+mD+1>buf)?buf+1:0));\n\t\t\to3DR += (a3DR[readIndex34] *((mD-floor(mD))));\nlet readIndex35: Int = trunc(c3GR+mG-((c3GR+mG>buf)?buf+1:0));\n\t\t\tlet o3GR = a3GR[readIndex35] *(1.0-(mG-floor(mG)));\nlet readIndex36: Int = trunc(c3GR+mG+1-((c3GR+mG+1>buf)?buf+1:0));\n\t\t\to3GR += (a3GR[readIndex36] *((mG-floor(mG))));\n\t\t\t\n\t\t\tf3AL = (((o3GR + o3HR) * -2.0) + o3IR);\t\t\t\t\n\t\t\tf3BL = (((o3GR + o3HR) * -2.0) + o3IR);\n\t\t\tf3CL = (((o3GR + o3HR) * -2.0) + o3IR);\n\t\t\t\n\t\t\tf3CR = (((o3AL + o3DL) * -2.0) + o3GL);\n\t\t\tf3FR = (((o3AL + o3DL) * -2.0) + o3GL);\n\t\t\tf3IR = (((o3AL + o3DL) * -2.0) + o3GL);\n\t\t\t\n\t\t\tlet reverbSampleL = (o3GL + o3HL + o3IL)*0.03125;\n\t\t\tlet reverbSampleR = (o3AR + o3DR + o3GR)*0.03125;\n\t\t\t\n\t\t\tf3AL = (f3AL+f3AL+f3AL+abs(avg3L))*0.25; avg3L = f3AL;\n\t\t\tf3CR = (f3CR+f3CR+f3CR+abs(avg3R))*0.25; avg3R = f3CR;\n\n\t\t\treverbSampleL = minimum(maximum(reverbSampleL,-4.0),4.0);\n\t\t\tif (wasPosClipL == 1) { \n\t\t\t\tif (reverbSampleL<lastSampleL) lastSampleL=0.79+(reverbSampleL*0.2);\n\t\t\t\telse lastSampleL = 0.2+(lastSampleL*0.79);\n\t\t\t} wasPosClipL = 0;\n\t\t\tif (reverbSampleL>0.99) {wasPosClipL=1;reverbSampleL=0.79+(lastSampleL*0.2);}\n\t\t\tif (wasNegClipL == 1) { \n\t\t\t\tif (reverbSampleL > lastSampleL) lastSampleL=-0.79+(reverbSampleL*0.2);\n\t\t\t\telse lastSampleL=-0.2+(lastSampleL*0.79);\n\t\t\t} wasNegClipL = 0;\n\t\t\tif (reverbSampleL<-0.99) {wasNegClipL=1;reverbSampleL=-0.79+(lastSampleL*0.2);}\n\t\t\tlastSampleL = reverbSampleL;\n\t\t\treverbSampleR = minimum(maximum(reverbSampleR,-4.0),4.0);\n\t\t\tif (wasPosClipR == 1) { \n\t\t\t\tif (reverbSampleR<lastSampleR) lastSampleR=0.79+(reverbSampleR*0.2);\n\t\t\t\telse lastSampleR = 0.2+(lastSampleR*0.79);\n\t\t\t} wasPosClipR = 0;\n\t\t\tif (reverbSampleR>0.99) {wasPosClipR=1;reverbSampleR=0.79+(lastSampleR*0.2);}\n\t\t\tif (wasNegClipR == 1) { \n\t\t\t\tif (reverbSampleR > lastSampleR) lastSampleR=-0.79+(reverbSampleR*0.2);\n\t\t\t\telse lastSampleR=-0.2+(lastSampleR*0.79);\n\t\t\t} wasNegClipR = 0;\n\t\t\tif (reverbSampleR<-0.99) {wasNegClipR=1;reverbSampleR=-0.79+(lastSampleR*0.2);}\n\t\t\tlastSampleR = reverbSampleR;\n\n\t\t\treverbSampleL = asin(reverbSampleL*0.7);\n\t\t\treverbSampleR = asin(reverbSampleR*0.7);\n\t\t\t\n\t\t\tbez[bez_CL] = bez[bez_BL];\n\t\t\tbez[bez_BL] = bez[bez_AL];\n\t\t\tbez[bez_AL] = reverbSampleL;\n\t\t\tbez[bez_SampL] = 0.0;\n\t\t\t\n\t\t\tbez[bez_CR] = bez[bez_BR];\n\t\t\tbez[bez_BR] = bez[bez_AR];\n\t\t\tbez[bez_AR] = reverbSampleR;\n\t\t\tbez[bez_SampR] = 0.0;\n\t\t}\n\t\t\n\t\tlet X = bez[bez_cycle] * bezTrim;\n\t\tlet CBL = (bez[bez_CL]*(1.0-X))+(bez[bez_BL]*X);\n\t\tlet CBR = (bez[bez_CR]*(1.0-X))+(bez[bez_BR]*X);\n\t\tlet BAL = (bez[bez_BL]*(1.0-X))+(bez[bez_AL]*X);\n\t\tlet BAR = (bez[bez_BR]*(1.0-X))+(bez[bez_AR]*X);\n\t\tlet CBAL = (bez[bez_BL]+(CBL*(1.0-X))+(BAL*X))*-0.25;\n\t\tlet CBAR = (bez[bez_BR]+(CBR*(1.0-X))+(BAR*X))*-0.25;\n\t\tinputSampleL = CBAL+bez[bez_AvgOutSampL]; bez[bez_AvgOutSampL] = CBAL;\n\t\tinputSampleR = CBAR+bez[bez_AvgOutSampR]; bez[bez_AvgOutSampR] = CBAR;\n\t\t\n\t\tif (out != 1.0) {\n\t\t\tinputSampleL *= out;\n\t\t\tinputSampleR *= out;\n\t\t}\n\t\t\n\t\tif (wet != 1.0) {\n\t\t\tinputSampleL = (inputSampleL * wet) + (drySampleL * (1.0-wet));\n\t\t\tinputSampleR = (inputSampleR * wet) + (drySampleR * (1.0-wet));\n\t\t}\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\nout1 = inputSampleL;\nout2 = inputSampleR;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
