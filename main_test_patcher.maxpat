                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "code": "/* X2Buss — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: High\n@param({ min: 0, max: 1 }) p_high = 0.5;\n// VST B: HMid\n@param({ min: 0, max: 1 }) p_hmid = 0.5;\n// VST C: LMid\n@param({ min: 0, max: 1 }) p_lmid = 0.5;\n// VST D: Bass\n@param({ min: 0, max: 1 }) p_bass = 0.5;\n// VST E: HighF\n@param({ min: 0, max: 1 }) p_highf = 0.5;\n// VST F: HMidF\n@param({ min: 0, max: 1 }) p_hmidf = 0.5;\n// VST G: LMidF\n@param({ min: 0, max: 1 }) p_lmidf = 0.5;\n// VST H: BassF\n@param({ min: 0, max: 1 }) p_bassf = 0.5;\n// VST I: Thresh\n@param({ min: 0, max: 1 }) p_thresh = 1.0;\n// VST J: Fader\n@param({ min: 0, max: 1 }) p_fader = 0.5;\n\nconst biq_freq = 0;\nconst biq_reso = 1;\nconst biq_a0 = 2;\nconst biq_a1 = 3;\nconst biq_a2 = 4;\nconst biq_b1 = 5;\nconst biq_b2 = 6;\nconst biq_sL1 = 7;\nconst biq_sL2 = 8;\nconst biq_sR1 = 9;\nconst biq_sR2 = 10;\nconst biq_total = 11;\nconst bez_AL = 0;\nconst bez_BL = 1;\nconst bez_CL = 2;\nconst bez_InL = 3;\nconst bez_UnInL = 4;\nconst bez_SampL = 5;\nconst bez_AR = 6;\nconst bez_BR = 7;\nconst bez_CR = 8;\nconst bez_InR = 9;\nconst bez_UnInR = 10;\nconst bez_SampR = 11;\nconst bez_cycle = 12;\nconst bez_total = 13;\n@state highA = new FixedFloat64Array(biq_total);\n@state highB = new FixedFloat64Array(biq_total);\n@state highC = new FixedFloat64Array(biq_total);\n@state highLIIR = 0;\n@state highRIIR = 0;\n@state midA = new FixedFloat64Array(biq_total);\n@state midB = new FixedFloat64Array(biq_total);\n@state midC = new FixedFloat64Array(biq_total);\n@state midLIIR = 0;\n@state midRIIR = 0;\n@state lowA = new FixedFloat64Array(biq_total);\n@state lowB = new FixedFloat64Array(biq_total);\n@state lowC = new FixedFloat64Array(biq_total);\n@state lowLIIR = 0;\n@state lowRIIR = 0;\n@state bezCompF = new FixedFloat64Array(bez_total);\n@state bezMaxF = 0;\n@state bezCompS = new FixedFloat64Array(bez_total);\n@state lastSampleL = 0;\n@state intermediateL = new FixedFloat64Array(33);\n@state slewL = new FixedFloat64Array(65);\n@state wasPosClipL = 0;\n@state wasNegClipL = 0;\n@state lastSampleR = 0;\n@state intermediateR = new FixedFloat64Array(33);\n@state slewR = new FixedFloat64Array(65);\n@state wasPosClipR = 0;\n@state wasNegClipR = 0;\n@state inTrimA = 0;\n@state inTrimB = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state spacing: Int = 0;\n@state trebleGain = 0;\n@state highmidGain = 0;\n@state lowmidGain = 0;\n@state bassGain = 0;\n@state trebleRef = 0;\n@state highmidRef = 0;\n@state lowmidRef = 0;\n@state bassRef = 0;\n@state highF = 0;\n@state bassF = 0;\n@state midF = 0;\n@state highQ = 0;\n@state midQ = 0;\n@state lowQ = 0;\n@state highFreq = 0;\n@state omega = 0;\n@state biqK = 0;\n@state highCoef = 0;\n@state midFreq = 0;\n@state midCoef = 0;\n@state lowFreq = 0;\n@state lowCoef = 0;\n@state norm = 0;\n@state bezCThresh = 0;\n@state bezRez = 0;\n@state stepped: Int = 0;\n@state bezTrim = 0;\n@state sloRez = 0;\n@state sloTrim = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor (let x: Int = 0; x < biq_total; x++) {\n\t\thighA[x] = 0.0;\n\t\thighB[x] = 0.0;\n\t\thighC[x] = 0.0;\n\t\tmidA[x] = 0.0;\n\t\tmidB[x] = 0.0;\n\t\tmidC[x] = 0.0;\n\t\tlowA[x] = 0.0;\n\t\tlowB[x] = 0.0;\n\t\tlowC[x] = 0.0;\n\t}\n\thighLIIR = 0.0;\n\thighRIIR = 0.0;\n\tmidLIIR = 0.0;\n\tmidRIIR = 0.0;\n\tlowLIIR = 0.0;\n\tlowRIIR = 0.0;\n\n\tfor (let x: Int = 0; x < bez_total; x++) {bezCompF[x] = 0.0;bezCompS[x] = 0.0;}\n\tbezCompF[bez_cycle] = 1.0; bezMaxF = 0.0;\n\tbezCompS[bez_cycle] = 1.0;\n\n\tlastSampleL = 0.0;\n\twasPosClipL = 0;\n\twasNegClipL = 0;\n\tlastSampleR = 0.0;\n\twasPosClipR = 0;\n\twasNegClipR = 0;\n\tfor (let x: Int = 0; x < 17; x++) {intermediateL[x] = 0.0; intermediateR[x] = 0.0;}\n\tfor (let x: Int = 0; x < 33; x++) {slewL[x] = 0.0; slewR[x] = 0.0;}\n\t\n\tinTrimA = 0.5; inTrimB = 0.5;\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\tspacing = floor(overallscale*2.0);\n\tif (spacing < 2) spacing = 2; if (spacing > 32) spacing = 32;\n\t\n\ttrebleGain = (p_high-0.5)*2.0;\n\ttrebleGain = 1.0+(trebleGain*abs(trebleGain)*abs(trebleGain));\n\thighmidGain = (p_hmid-0.5)*2.0;\n\thighmidGain = 1.0+(highmidGain*abs(highmidGain)*abs(highmidGain));\n\tlowmidGain = (p_lmid-0.5)*2.0;\n\tlowmidGain = 1.0+(lowmidGain*abs(lowmidGain)*abs(lowmidGain));\n\tbassGain = (p_bass-0.5)*2.0;\n\tbassGain = 1.0+(bassGain*abs(bassGain)*abs(bassGain));\n\t\n\ttrebleRef = p_highf-0.5;\n\thighmidRef = p_hmidf-0.5;\n\tlowmidRef = p_lmidf-0.5;\n\tbassRef = p_bassf-0.5;\n\thighF = 0.75 + ((trebleRef+trebleRef+trebleRef+highmidRef)*0.125);\n\tbassF = 0.25 + ((lowmidRef+bassRef+bassRef+bassRef)*0.125);\n\tmidF = (highF*0.5) + (bassF*0.5) + ((highmidRef+lowmidRef)*0.125);\n\t\n\thighQ = maximum(minimum(1.0+(highmidRef-trebleRef),4.0),0.125);\n\tmidQ = maximum(minimum(1.0+(lowmidRef-highmidRef),4.0),0.125);\n\tlowQ = maximum(minimum(1.0+(bassRef-lowmidRef),4.0),0.125);\n\t\n\thighA[biq_freq] = ((pow(highF,3)*20000.0)/samplerate());\n\thighC[biq_freq] = highB[biq_freq] = highA[biq_freq] = maximum(minimum(highA[biq_freq],0.4999),0.00025);\n\thighFreq = pow(highF,3)*20000.0;\n\tomega = 2.0*PI*(highFreq/samplerate());\n\tbiqK = 2.0-cos(omega);\n\thighCoef = -sqrt((biqK*biqK)-1.0)+biqK;\n\thighA[biq_reso] = 2.24697960 * highQ;\n\thighB[biq_reso] = 0.80193774 * highQ;\n\thighC[biq_reso] = 0.55495813 * highQ;\n\t\n\tmidA[biq_freq] = ((pow(midF,3)*20000.0)/samplerate());\n\tmidC[biq_freq] = midB[biq_freq] = midA[biq_freq] = maximum(minimum(midA[biq_freq],0.4999),0.00025);\t\n\tmidFreq = pow(midF,3)*20000.0;\n\tomega = 2.0*PI*(midFreq/samplerate());\n\tbiqK = 2.0-cos(omega);\n\tmidCoef = -sqrt((biqK*biqK)-1.0)+biqK;\n\tmidA[biq_reso] = 2.24697960 * midQ;\n\tmidB[biq_reso] = 0.80193774 * midQ;\n\tmidC[biq_reso] = 0.55495813 * midQ;\n\t\n\tlowA[biq_freq] = ((pow(bassF,3)*20000.0)/samplerate());\n\tlowC[biq_freq] = lowB[biq_freq] = lowA[biq_freq] = maximum(minimum(lowA[biq_freq],0.4999),0.00025);\n\tlowFreq = pow(bassF,3)*20000.0;\n\tomega = 2.0*PI*(lowFreq/samplerate());\n\tbiqK = 2.0-cos(omega);\n\tlowCoef = -sqrt((biqK*biqK)-1.0)+biqK;\n\tlowA[biq_reso] = 2.24697960 * lowQ;\n\tlowB[biq_reso] = 0.80193774 * lowQ;\n\tlowC[biq_reso] = 0.55495813 * lowQ;\n\t\n\tbiqK = tan(PI * highA[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / highA[biq_reso] + biqK * biqK);\n\thighA[biq_a0] = biqK * biqK * norm;\n\thighA[biq_a1] = 2.0 * highA[biq_a0];\n\thighA[biq_a2] = highA[biq_a0];\n\thighA[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\thighA[biq_b2] = (1.0 - biqK / highA[biq_reso] + biqK * biqK) * norm;\n\tbiqK = tan(PI * highB[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / highB[biq_reso] + biqK * biqK);\n\thighB[biq_a0] = biqK * biqK * norm;\n\thighB[biq_a1] = 2.0 * highB[biq_a0];\n\thighB[biq_a2] = highB[biq_a0];\n\thighB[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\thighB[biq_b2] = (1.0 - biqK / highB[biq_reso] + biqK * biqK) * norm;\n\tbiqK = tan(PI * highC[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / highC[biq_reso] + biqK * biqK);\n\thighC[biq_a0] = biqK * biqK * norm;\n\thighC[biq_a1] = 2.0 * highC[biq_a0];\n\thighC[biq_a2] = highC[biq_a0];\n\thighC[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\thighC[biq_b2] = (1.0 - biqK / highC[biq_reso] + biqK * biqK) * norm;\n\t\n\tbiqK = tan(PI * midA[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / midA[biq_reso] + biqK * biqK);\n\tmidA[biq_a0] = biqK * biqK * norm;\n\tmidA[biq_a1] = 2.0 * midA[biq_a0];\n\tmidA[biq_a2] = midA[biq_a0];\n\tmidA[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\tmidA[biq_b2] = (1.0 - biqK / midA[biq_reso] + biqK * biqK) * norm;\n\tbiqK = tan(PI * midB[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / midB[biq_reso] + biqK * biqK);\n\tmidB[biq_a0] = biqK * biqK * norm;\n\tmidB[biq_a1] = 2.0 * midB[biq_a0];\n\tmidB[biq_a2] = midB[biq_a0];\n\tmidB[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\tmidB[biq_b2] = (1.0 - biqK / midB[biq_reso] + biqK * biqK) * norm;\n\tbiqK = tan(PI * midC[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / midC[biq_reso] + biqK * biqK);\n\tmidC[biq_a0] = biqK * biqK * norm;\n\tmidC[biq_a1] = 2.0 * midC[biq_a0];\n\tmidC[biq_a2] = midC[biq_a0];\n\tmidC[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\tmidC[biq_b2] = (1.0 - biqK / midC[biq_reso] + biqK * biqK) * norm;\n\t\n\tbiqK = tan(PI * lowA[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / lowA[biq_reso] + biqK * biqK);\n\tlowA[biq_a0] = biqK * biqK * norm;\n\tlowA[biq_a1] = 2.0 * lowA[biq_a0];\n\tlowA[biq_a2] = lowA[biq_a0];\n\tlowA[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\tlowA[biq_b2] = (1.0 - biqK / lowA[biq_reso] + biqK * biqK) * norm;\n\tbiqK = tan(PI * lowB[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / lowB[biq_reso] + biqK * biqK);\n\tlowB[biq_a0] = biqK * biqK * norm;\n\tlowB[biq_a1] = 2.0 * lowB[biq_a0];\n\tlowB[biq_a2] = lowB[biq_a0];\n\tlowB[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\tlowB[biq_b2] = (1.0 - biqK / lowB[biq_reso] + biqK * biqK) * norm;\n\tbiqK = tan(PI * lowC[biq_freq]);\n\tnorm = 1.0 / (1.0 + biqK / lowC[biq_reso] + biqK * biqK);\n\tlowC[biq_a0] = biqK * biqK * norm;\n\tlowC[biq_a1] = 2.0 * lowC[biq_a0];\n\tlowC[biq_a2] = lowC[biq_a0];\n\tlowC[biq_b1] = 2.0 * (biqK * biqK - 1.0) * norm;\n\tlowC[biq_b2] = (1.0 - biqK / lowC[biq_reso] + biqK * biqK) * norm;\n\n\tbezCThresh = pow(1.0-p_thresh, 6.0) * 8.0;\n\tbezRez = pow(1.0-p_thresh, 12.360679774997898) / overallscale;\n\tbezRez = minimum(maximum(bezRez,0.00001),1.0);\n\tstepped = 999999; if (bezRez > 0.000001) stepped = toIndex(1.0/bezRez);\n\tbezRez = 0.99999999 / stepped;\n\tbezTrim = 1.0-(bezRez*(stepped/(stepped+1.0)));\n\tsloRez = pow(1.0-p_thresh,10.0) / overallscale;\n\tsloRez = minimum(maximum(sloRez,0.00001),1.0);\n\tstepped = 999999; if (sloRez > 0.000001) stepped = toIndex(1.0/sloRez);\n\tsloRez = 0.99999999 / stepped;\n\tsloTrim = 1.0-(sloRez*(stepped/(stepped+1.0)));\n\n\tinTrimA = inTrimB; inTrimB = p_fader*2.0;\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tif (inputSampleL > 1.0) inputSampleL = 1.0;\n\t\telse if (inputSampleL > 0.0) inputSampleL = -expm1((log1p(-inputSampleL) * 0.6180339887498949));\n\t\tif (inputSampleL < -1.0) inputSampleL = -1.0;\n\t\telse if (inputSampleL < 0.0) inputSampleL = expm1((log1p(inputSampleL) * 0.6180339887498949));\n\t\t\n\t\tif (inputSampleR > 1.0) inputSampleR = 1.0;\n\t\telse if (inputSampleR > 0.0) inputSampleR = -expm1((log1p(-inputSampleR) * 0.6180339887498949));\n\t\tif (inputSampleR < -1.0) inputSampleR = -1.0;\n\t\telse if (inputSampleR < 0.0) inputSampleR = expm1((log1p(inputSampleR) * 0.6180339887498949));\n\t\t\n\t\tlet trebleL = inputSampleL;\t\t\n\t\tlet outSample = (trebleL * highA[biq_a0]) + highA[biq_sL1];\n\t\thighA[biq_sL1] = (trebleL * highA[biq_a1]) - (outSample * highA[biq_b1]) + highA[biq_sL2];\n\t\thighA[biq_sL2] = (trebleL * highA[biq_a2]) - (outSample * highA[biq_b2]);\n\t\tlet highmidL = outSample; trebleL -= highmidL;\n\t\t\n\t\toutSample = (highmidL * midA[biq_a0]) + midA[biq_sL1];\n\t\tmidA[biq_sL1] = (highmidL * midA[biq_a1]) - (outSample * midA[biq_b1]) + midA[biq_sL2];\n\t\tmidA[biq_sL2] = (highmidL * midA[biq_a2]) - (outSample * midA[biq_b2]);\n\t\tlet lowmidL = outSample; highmidL -= lowmidL;\n\t\t\n\t\toutSample = (lowmidL * lowA[biq_a0]) + lowA[biq_sL1];\n\t\tlowA[biq_sL1] = (lowmidL * lowA[biq_a1]) - (outSample * lowA[biq_b1]) + lowA[biq_sL2];\n\t\tlowA[biq_sL2] = (lowmidL * lowA[biq_a2]) - (outSample * lowA[biq_b2]);\n\t\tlet bassL = outSample; lowmidL -= bassL;\n\t\t\n\t\ttrebleL = (bassL*bassGain) + (lowmidL*lowmidGain) + (highmidL*highmidGain) + (trebleL*trebleGain);\n\n\t\toutSample = (trebleL * highB[biq_a0]) + highB[biq_sL1];\n\t\thighB[biq_sL1] = (trebleL * highB[biq_a1]) - (outSample * highB[biq_b1]) + highB[biq_sL2];\n\t\thighB[biq_sL2] = (trebleL * highB[biq_a2]) - (outSample * highB[biq_b2]);\n\t\thighmidL = outSample; trebleL -= highmidL;\n\t\t\n\t\toutSample = (highmidL * midB[biq_a0]) + midB[biq_sL1];\n\t\tmidB[biq_sL1] = (highmidL * midB[biq_a1]) - (outSample * midB[biq_b1]) + midB[biq_sL2];\n\t\tmidB[biq_sL2] = (highmidL * midB[biq_a2]) - (outSample * midB[biq_b2]);\n\t\tlowmidL = outSample; highmidL -= lowmidL;\n\t\t\n\t\toutSample = (lowmidL * lowB[biq_a0]) + lowB[biq_sL1];\n\t\tlowB[biq_sL1] = (lowmidL * lowB[biq_a1]) - (outSample * lowB[biq_b1]) + lowB[biq_sL2];\n\t\tlowB[biq_sL2] = (lowmidL * lowB[biq_a2]) - (outSample * lowB[biq_b2]);\n\t\tbassL = outSample; lowmidL -= bassL;\n\t\t\n\t\ttrebleL = (bassL*bassGain) + (lowmidL*lowmidGain) + (highmidL*highmidGain) + (trebleL*trebleGain);\n\n\t\toutSample = (trebleL * highC[biq_a0]) + highC[biq_sL1];\n\t\thighC[biq_sL1] = (trebleL * highC[biq_a1]) - (outSample * highC[biq_b1]) + highC[biq_sL2];\n\t\thighC[biq_sL2] = (trebleL * highC[biq_a2]) - (outSample * highC[biq_b2]);\n\t\thighmidL = outSample; trebleL -= highmidL;\n\t\t\n\t\toutSample = (highmidL * midC[biq_a0]) + midC[biq_sL1];\n\t\tmidC[biq_sL1] = (highmidL * midC[biq_a1]) - (outSample * midC[biq_b1]) + midC[biq_sL2];\n\t\tmidC[biq_sL2] = (highmidL * midC[biq_a2]) - (outSample * midC[biq_b2]);\n\t\tlowmidL = outSample; highmidL -= lowmidL;\n\t\t\n\t\toutSample = (lowmidL * lowC[biq_a0]) + lowC[biq_sL1];\n\t\tlowC[biq_sL1] = (lowmidL * lowC[biq_a1]) - (outSample * lowC[biq_b1]) + lowC[biq_sL2];\n\t\tlowC[biq_sL2] = (lowmidL * lowC[biq_a2]) - (outSample * lowC[biq_b2]);\n\t\tbassL = outSample; lowmidL -= bassL;\n\t\t\n\t\ttrebleL = (bassL*bassGain) + (lowmidL*lowmidGain) + (highmidL*highmidGain) + (trebleL*trebleGain);\n\n\t\thighLIIR = (highLIIR*highCoef) + (trebleL*(1.0-highCoef));\n\t\thighmidL = highLIIR; trebleL -= highmidL;\n\t\t\n\t\tmidLIIR = (midLIIR*midCoef) + (highmidL*(1.0-midCoef));\n\t\tlowmidL = midLIIR; highmidL -= lowmidL;\n\t\t\n\t\tlowLIIR = (lowLIIR*lowCoef) + (lowmidL*(1.0-lowCoef));