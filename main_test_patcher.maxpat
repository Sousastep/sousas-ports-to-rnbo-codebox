ez_BR]+(CBR*(1.0-X))+(BAR*X))*-0.25;\n\t\t\n\t\tbezF[bez_cycle] += derezFreq;\n\t\tbezF[bez_SampL] += (inputSampleL * derezFreq);\n\t\tbezF[bez_SampR] += (inputSampleR * derezFreq);\n\t\tif (bezF[bez_cycle] > 1.0) { \n\t\t\tbezF[bez_cycle] = 0.0;\n\t\t\tbezF[bez_CL] = bezF[bez_BL];\n\t\t\tbezF[bez_BL] = bezF[bez_AL];\n\t\t\tbezF[bez_AL] = bezF[bez_SampL];\n\t\t\tbezF[bez_SampL] = 0.0;\n\t\t\tbezF[bez_CR] = bezF[bez_BR];\n\t\t\tbezF[bez_BR] = bezF[bez_AR];\n\t\t\tbezF[bez_AR] = bezF[bez_SampR];\n\t\t\tbezF[bez_SampR] = 0.0;\n\t\t}\n\t\tX = bezF[bez_cycle]*bezFreqTrim;\n\t\tlet CBLfreq = (bezF[bez_CL]*(1.0-X))+(bezF[bez_BL]*X);\n\t\tlet BALfreq = (bezF[bez_BL]*(1.0-X))+(bezF[bez_AL]*X);\n\t\tinputSampleL = (bezF[bez_BL]+(CBLfreq*(1.0-X))+(BALfreq*X))*0.25;\n\t\tlet CBRfreq = (bezF[bez_CR]*(1.0-X))+(bezF[bez_BR]*X);\n\t\tlet BARfreq = (bezF[bez_BR]*(1.0-X))+(bezF[bez_AR]*X);\n\t\tinputSampleR = (bezF[bez_BR]+(CBRfreq*(1.0-X))+(BARfreq*X))*0.25;\n\n\t\tinputSampleL = (inputSampleL * wet)+(drySampleL * (1.0-wet));\n\t\tinputSampleR = (inputSampleR * wet)+(drySampleR * (1.0-wet));\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\nout1 = inputSampleL;\nout2 = inputSampleR;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
