                            {
                                "box": {
                                    "code": "/* mrelwood_Chmahastic_Reverb_2 — RNBO codebox~ port of mrelwood source.\n * Stereo in1/in2 -> out1/out2; original slider units and defaults.\n * Graphics and GUI meters omitted. See RNBO/README.md and VALIDATION.md.\n *   Version: 0.1\n * desc: Chmahastic Reverb 2 [mrelwood]\n * author: mrelwood plugins\n * about:\n *   Uses DSP from airwindows \"Verbity2\" by Chris Johnson\n *   https://github.com/airwindows/airwindows/tree/master/plugins/LinuxVST/src/Verbity2 (MIT License)\n *   JSFX version released under GPLv3 license\n *   \n * Version history:\n * \n * 0.11\n * - Larger vol \n */\n// -Room Size\n@param({ min: 0, max: 100 }) slider1 = 60;\n// -Decay\n@param({ min: 0, max: 100 }) slider2 = 50;\n// -Dampen\n@param({ min: 0, max: 100 }) slider3 = 40;\n// -Pre-Delay (ms)\n@param({ min: 0, max: 100 }) slider4 = 30;\n// -Input Attack\n@param({ min: 0, max: 100 }) slider5 = 90;\n// -Low-Pass Frequency (KHz)\n@param({ min: 1, max: 20 }) slider6 = 8;\n// -Hi-Mid Gain (dB)\n@param({ min: -9, max: 6 }) slider7 = 0;\n// -Hi-Mid Frequency (Hz)\n@param({ min: 1000, max: 8000 }) slider8 = 3500;\n// -Mid Gain (dB)\n@param({ min: -9, max: 6 }) slider9 = 0;\n// -Mid Frequency (Hz)\n@param({ min: 300, max: 5000 }) slider10 = 1000;\n// -Lo-Mid Gain (dB)\n@param({ min: -9, max: 6 }) slider11 = 0;\n// -Lo-Mid Frequency\n@param({ min: 150, max: 2000 }) slider12 = 200;\n// -High-Pass Frequency (Hz)\n@param({ min: 50, max: 1000 }) slider13 = 50;\n// -Stereo Width\n@param({ min: -150, max: 150 }) slider14 = 120;\n// -Mix\n@param({ min: 0, max: 100 }) slider15 = 100;\n// -Volume (dB)\n@param({ min: -30, max: 9 }) slider16 = 0;\n@state ram = new FixedFloat64Array(160000);\n@state s_initialized = 0;\n@state frame: Int = 0;\n@state prepared = 0;\n@state s_A = 0;\n@state s_B = 0;\n@state s_C = 0;\n@state s_L_aA = 0;\n@state s_L_aB = 0;\n@state s_L_aC = 0;\n@state s_L_aD = 0;\n@state s_L_aE = 0;\n@state s_L_aF = 0;\n@state s_L_aG = 0;\n@state s_L_