ple*density); \n\t\tif (phattity > 0.0) inputSampleR = (inputSampleR*(1-phattity))+(phatSample*phattity); \n\t\tbip[bip_dvRA] = bip_delta - inputSampleR; \n\t\tbip[bip_dvRB] = bip[bip_pvRA]-bip[bip_dvRA]; bip[bip_pvRA] = bip[bip_dvRA];\n\t\tbip[bip_dvRC] = bip[bip_pvRB]-bip[bip_dvRB]; bip[bip_pvRB] = bip[bip_dvRB];\n\t\tbip[bip_dvRD] = bip[bip_pvRC]-bip[bip_dvRC]; bip[bip_pvRC] = bip[bip_dvRC];\n\t\tbip_dvE = bip[bip_pvRD]-bip[bip_dvRD]; bip[bip_pvRD] = bip[bip_dvRD];\n\t\tinputSampleR *= (1.0+(abs(bip[bip_dvRC])*0.0618)+(abs(bip[bip_dvRD])*-0.05982)+(abs(bip_dvE)*0.0206));\n\t\t\n\t\tlet clamp = (lastSampleLB - lastSampleLC) * 0.381966011250105;\n\t\tclamp -= (lastSampleLA - lastSampleLB) * 0.6180339887498948482045;\n\t\tclamp += inputSampleL - lastSampleLA; \n\t\tlastSampleLC = lastSampleLB;\n\t\tlastSampleLB = lastSampleLA;\n\t\tlastSampleLA = inputSampleL; \n\t\tif (clamp > threshold)\n\t\t\tinputSampleL = lastSampleLB + threshold;\n\t\tif (-clamp > threshold)\n\t\t\tinputSampleL = lastSampleLB - threshold;\n\t\t\n\t\tlastSampleLA = (lastSampleLA*0.381966011250105)+(inputSampleL*0.6180339887498948482045);\n\t\t\n\t\tclamp = (lastSampleRB - lastSampleRC) * 0.381966011250105;\n\t\tclamp -= (lastSampleRA - lastSampleRB) * 0.6180339887498948482045;\n\t\tclamp += inputSampleR - lastSampleRA; \n\t\tlastSampleRC = lastSampleRB;\n\t\tlastSampleRB = lastSampleRA;\n\t\tlastSampleRA = inputSampleR; \n\t\tif (clamp > threshold)\n\t\t\tinputSampleR = lastSampleRB + threshold;\n\t\tif (-clamp > threshold)\n\t\t\tinputSampleR = lastSampleRB - threshold;\n\t\t\n\t\tlastSampleRA = (lastSampleRA*0.381966011250105)+(inputSampleR*0.6180339887498948482045);\n\n\t\tflip = !flip;\n\t\tif (output < 1.0)\n\t\t{\n\t\t\tinputSampleL *= output;\n\t\t\tinputSampleR *= output;\n\t\t}\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\t\tif (unsigned32(fpdL-fpdR) < 1073741824 || unsigned32(fpdR-fpdL) < 1073741824) {\n\t\t\tfpdR = advanceRandom(fpdR);}\n\nout1 = inputSampl