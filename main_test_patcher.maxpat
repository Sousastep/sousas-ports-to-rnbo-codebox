                    },
                    "outlettype": [ "signal", "signal", "list" ],
                    "patcher": {
                        "fileversion": 1,
                        "appversion": {
                            "major": 9,
                            "minor": 1,
                            "revision": 5,
                            "architecture": "x64",
                            "modernui": 1
                        },
                        "classnamespace": "rnbo",
                        "rect": [ 365.0, 447.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "// RCInflator 2 (Ideal Edition), lewloiwc, v1.0.\n// Inspired by Sonnox Oxford Inflator / RCJacH, sai'ke and chmaha.\n// RNBO codebox~: in1/in2 = stereo input; out1/out2 = stereo output.\n// Original slider units and defaults. Effect In is NOT a full bypass:\n// input gain, input clipping and output gain remain active, as in JSFX.\n@param({ min: -6, max: 12 }) input_db = 0;\n@param({ min: 0, max: 100 }) effect = 0;\n@param({ min: -50, max: 50 }) curve = 0;\n@param({ enum: [\"Off\", \"On\"] }) clip = 1;\n@param({ enum: [\"Off\", \"On\"] }) band_split = 0;\n@param({ enum: [\"Off\", \"On\"] }) effect_in = 1;\n@param({ min: -12, max: 0 }) output_db = 0;\n\n@state integrators = new FixedFloat64Array(2, 2);\n@state ca = 0;\n@state cb = 0;\n@state midgain = 1;\n@state pre = 1;\n@state postgain = 1;\n@state wet = 0;\n@state dry = 1;\n@state a = 1.5;\n@state b = 0;\n@state c = -0.5;\n@state d = 0.0625;\n@state frame: Int = 0;\n\nfunction dspsetup() { frame = 0; }\nfunction shape(x) {\n    let y = abs(x);\n    let shaped = 0;\n    if (y < 1) {\n        let yy = y*y;\n        shaped = a*y + b*yy + c*y*yy - d*(yy - 2*yy*y + yy*yy);\n    } else if (y < 2) {\n        shaped = 2*y - y*y;\n    }\n    let polarity = 0;\n    if (x > 0) polarity = 1;\n    if (x < 0) polarity = -1;\n    return shaped*wet*polarity + x*dry;\n}\nfunction processChannel(x, ch: Int) {\n    let limit = 2;\n    if (clip != 0) limit = 1;\n    x = clamp(x*pre, -limit, limit);\n    if (effect_in != 0) {\n        if (band_split != 0) {\n            let low = integrators[ch][0] + ca*(x-integrators[ch][0]);\n            integrators[ch][0] = 2*low-integrators[ch][0];\n            let r = (1-cb)*integrators[ch][1] + cb*x;\n            integrators[ch][1] = 2*r-integrators[ch][1];\n            let high = x-r;\n            let mid = x-low-high;\n            x = shape(low) + shape(mid*midgain)/midgain + shape(high);\n        } else {\n            x = shape(x);\n        }\n    }\n    return x*postgain;\n}\nif (frame == 0) {\n    // Source crossovers, updated on sample-rate changes as well.\n    ca = tan(PI*(240/samplerate()-0.25))*0.5+0.5;\n    cb = tan(PI*(2400/samplerate()-0.25))*0.5+0.5;\n    midgain = cb*(1-ca)/(cb-ca);\n    pre = pow(10, input_db*0.05);\n    postgain = pow(10, output_db*0.05);\n    wet = effect*0.01;\n    dry = 1-wet;\n    a = curve*0.01+1.5;\n    b = curve*-0.02;\n    c = curve*0.01-0.5;\n    d = 0.0625-curve*0.0025+curve*curve*0.000025;\n}\nout1 = processChannel(in1, 0);\nout2 = processChannel(in2, 1);\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "code": "// RCInflator 2 (Ideal Edition), lewloiwc, v1.0.\n// Inspired by Sonnox Oxford Inflator / RCJacH, sai'ke and chmaha.\n// RNBO codebox~: in1/in2 = stereo input; out1/out2 = stereo output.\n// Original slider units and defaults. Effect In is NOT a full bypass:\n// input gain, input clipping and output gain remain active, as in JSFX.\n@param({ min: -6, max: 12 }) input_db = 0;\n@param({ min: 0, max: 100 }) effect = 0;\n@param({ min: -50, max: 50 }) curve = 0;\n@param({ enum: [\"Off\", \"On\"] }) clip = 1;\n@param({ enum: [\"Off\", \"On\"] }) band_split = 0;\n@param({ enum: [\"Off\", \"On\"] }) effect_in = 1;\n@param({ min: -12, max: 0 }) output_db = 0;\n\n@state integrators = new FixedFloat64Array(2, 2);\n@state ca = 0;\n@state cb = 0;\n@state midgain = 1;\n@state pre = 1;\n@state postgain = 1;\n@state wet = 0;\n@state dry = 1;\n@state a = 1.5;\n@state b = 0;\n@state c = -0.5;\n@state d = 0.0625;\n@state frame: Int = 0;\n\nfunction dspsetup() { frame = 0; }\nfunction shape(x) {\n    let y = abs(x);\n    let shaped = 0;\n    if (y < 1) {\n        let yy = y*y;\n        shaped = a*y + b*yy + c*y*yy - d*(yy - 2*yy*y + yy*yy);\n    } else if (y < 2) {\n        shaped = 2*y - y*y;\n    }\n    let polarity = 0;\n    if (x > 0) polarity = 1;\n    if (x < 0) polarity = -1;\n    return shaped*wet*polarity + x*dry;\n}\nfunction processChannel(x, ch: Int) {\n    let limit = 2;\n    if (clip != 0) limit = 1;\n    x = clamp(x*pre, -limit, limit);\n    if (effect_in != 0) {\n        if (band_split != 0) {\n            let low = integrators[ch][0] + ca*(x-integrators[ch][0]);\n            integrators[ch][0] = 2*low-integrators[ch][0];\n            let r = (1-cb)*integrators[ch][1] + cb*x;\n            integrators[ch][1] = 2*r-integrators[ch][1];\n            let high = x-r;\n            let mid = x-low-high;\n            x = shape(low) + shape(mid*midgain)/midgain + shape(high);\n        } else {\n            x = shape(x);\n        }\n    }\n    return x*postgain;\n}\nif (frame == 0) {\n    // Source crossovers, updated on sample-rate changes as well.\n    ca = tan(PI*(240/samplerate()-0.25))*0.5+0.5;\n    cb = tan(PI*(2400/samplerate()-0.25))*0.5+0.5;\n    midgain = cb*(1-ca)/(cb-ca);\n    pre = pow(10, input_db*0.05);\n    postgain = pow(10, output_db*0.05);\n    wet = effect*0.01;\n    dry = 1-wet;\n    a = curve*0.01+1.5;\n    b = curve*-0.02;\n    c = curve*0.01-0.5;\n    d = 0.0625-curve*0.0025+curve*curve*0.000025;\n}\nout1 = processChannel(in1, 0);\nout2 = processChannel(in2, 1);\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
                                        "nocache": 0,
                                        "expr": ""
                                    },
