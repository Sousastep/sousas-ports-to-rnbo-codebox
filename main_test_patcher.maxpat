                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "/* Dynamics3 — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Thresh\n@param({ min: 0, max: 1 }) p_thresh = 1.0;\n// VST B: Attack\n@param({ min: 0, max: 1 }) p_attack = 0.382;\n// VST C: Release\n@param({ min: 0, max: 1 }) p_release = 0.618;\n// VST D: Inv/Wet\n@param({ min: 0, max: 1 }) p_invwet = 1.0;\n\nconst bez_A = 0;\nconst bez_B = 1;\nconst bez_C = 2;\nconst bez_Ctrl = 3;\nconst bez_cycle = 4;\nconst bez_min = 5;\nconst bez_comp = 6;\nconst bez_total = 7;\n@state bezComp = new FixedFloat64Array(bez_total);\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state bezThresh = 0;\n@state sqrThresh = 0;\n@state bezRez = 0;\n@state stepped: Int = 0;\n@state bezTrim = 0;\n@state sloRez = 0;\n@state invDry = 0;\n@state compress = 0;\n@state compBypass = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor (let x: Int = 0; x < bez_total; x++) bezComp[x] = 0.0;\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\n\tbezThresh = pow(p_thresh+0.6180339887498949,2.0)*1.6180339887498949;\n\tsqrThresh = sqrt(bezThresh);\n\tbezRez = maximum(pow((1.0-p_attack)*0.4,4.0)/overallscale,0.0001); \n\tbezRez /= (2.0/pow(overallscale,0.5-((overallscale-1.0)*0.0375)));\n\tstepped = 999999; if (bezRez > 0.000001) stepped = toIndex(1.0/bezRez);\n\tbezRez = 0.99999999 / stepped;\n\tbezTrim = 1.0-(bezRez*(stepped/(stepped+1.0)));\n\tsloRez = maximum(pow((1.0-p_release)*0.4,4.0)/overallscale,0.00001);\n\tsloRez /= (2.0/pow(overallscale,0.5-((overallscale-1.0)*0.0375)));\n\tinvDry = pow(1.0-(abs(p_invwet-0.5)*2.0),1.6180339887498949);\n\tcompress = (p_invwet > 0.499999);\n\tcompBypass = (bezThresh > 4.236);\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tif (!compBypass) {\n\t\t\t\n\t\t\tlet dryCompL = inputSampleL;\n\t\t\tlet dryCompR = inputSampleR;\n\t\t\tif (compress) {\n\t\t\t\tinputSampleL *= (bezComp[bez_comp]/bezThresh);\n\t\t\t\tinputSampleR *= (bezComp[bez_comp]/bezThresh);\n\t\t\t} else {\n\t\t\t\tinputSampleL /= bezThresh;\n\t\t\t\tinputSampleR /= bezThresh;\n\t\t\t}\n\t\t\tlet ctrl = minimum(maximum(abs(inputSampleL),abs(inputSampleR)),sqrThresh*bezComp[bez_comp]*0.6180339887498949);\n\t\t\tbezComp[bez_min] = maximum(bezComp[bez_min]-sloRez,ctrl);\n\t\t\tbezComp[bez_Ctrl] += (bezComp[bez_min] * bezRez);\n\t\t\tbezComp[bez_cycle] += bezRez;\n\t\t\tif (bezComp[bez_cycle] > bezTrim) {bezComp[bez_cycle] = 0.0;\n\t\t\t\tbezComp[bez_C] = bezComp[bez_B]; bezComp[bez_B] = bezComp[bez_A];\n\t\t\t\tbezComp[bez_A] = bezComp[bez_Ctrl]; bezComp[bez_Ctrl] = 0.0;}\n\t\t\tlet X = bezComp[bez_cycle];\n\t\t\tbezComp[bez_comp] = bezComp[bez_B]+(bezComp[bez_C]*(1.0-X)*(1.0-X))+(bezComp[bez_B]*2.0*(1.0-X)*X)+(bezComp[bez_A]*X*X);\n\t\t\tbezComp[bez_comp] = ((1.0-(minimum(bezComp[bez_comp],0.9999))));\n\t\t\tif (compress) {\n\t\t\t\tinputSampleL = inputSampleL*(1.0-invDry)*bezComp[bez_comp]*bezThresh;\n\t\t\t\tinputSampleL = maximum(minimum(inputSampleL,2.305929007734908),-2.305929007734908);\n\t\t\t\tlet addtwo = inputSampleL * inputSampleL;\n\t\t\t\tlet empower = inputSampleL * addtwo; \n\t\t\t\tinputSampleL -= (empower / 6.0); empower *= addtwo; \n\t\t\t\tinputSampleL += (empower / 69.0); empower *= addtwo; \n\t\t\t\tinputSampleL -= (empower / 2530.08); empower *= addtwo; \n\t\t\t\tinputSampleL += (empower / 224985.6); empower *= addtwo; \n\t\t\t\tinputSampleL -= (empower / 9979200.0);\t\t\t\t\n\t\t\t\t\n\t\t\t\tinputSampleL += dryCompL*invDry*(1.0-(bezComp[bez_comp]*(1.0-invDry)));\n\t\t\t\tinputSampleR = inputSampleR*(1.0-invDry)*bezComp[bez_comp]*bezThresh;\n\t\t\t\tinputSampleR = maximum(minimum(inputSampleR,2.305929007734908),-2.305929007734908);\n\t\t\t\taddtwo = inputSampleR * inputSampleR;\n\t\t\t\tempower = inputSampleR * addtwo; \n\t\t\t\tinputSampleR -= (empower / 6.0); empower *= addtwo; \n\t\t\t\tinputSampleR += (empower / 69.0); empower *= addtwo; \n\t\t\t\tinputSampleR -= (empower / 2530.08); empower *= addtwo; \n\t\t\t\tinputSampleR += (empower / 224985.6); empower *= addtwo; \n\t\t\t\tinputSampleR -= (empower / 9979200.0);\n\t\t\t\t\n\t\t\t\tinputSampleR += dryCompR*invDry*(1.0-(bezComp[bez_comp]*(1.0-invDry)));\n\t\t\t} else {\n\t\t\t\tinputSampleL = ((inputSampleL/(0.1+bezThresh))*(1.0-invDry))/bezComp[bez_comp];\n\t\t\t\tinputSampleL = maximum(minimum(inputSampleL,2.305929007734908),-2.305929007734908);\n\t\t\t\tlet addtwo = inputSampleL * inputSampleL;\n\t\t\t\tlet empower = inputSampleL * addtwo; \n\t\t\t\tinputSampleL -= (empower / 6.0); empower *= addtwo; \n\t\t\t\tinputSampleL += (empower / 69.0); empower *= addtwo; \n\t\t\t\tinputSampleL -= (empower / 2530.08); empower *= addtwo; \n\t\t\t\tinputSampleL += (empower / 224985.6); empower *= addtwo; \n\t\t\t\tinputSampleL -= (empower / 9979200.0);\t\t\t\t\n\t\t\t\t\n\t\t\t\tinputSampleL += dryCompL*invDry*(1.0-(bezComp[bez_comp]*(1.0-invDry)));\t\t\t\t\n\t\t\t\tinputSampleR = ((inputSampleR/(0.1+bezThresh))*(1.0-invDry))/bezComp[bez_comp];\n\t\t\t\tinputSampleR = maximum(minimum(inputSampleR,2.305929007734908),-2.305929007734908);\n\t\t\t\taddtwo = inputSampleR * inputSampleR;\n\t\t\t\tempower = inputSampleR * addtwo; \n\t\t\t\tinputSampleR -= (empower / 6.0); empower *= addtwo; \n\t\t\t\tinputSampleR += (empower / 69.0); empower *= addtwo; \n\t\t\t\tinputSampleR -= (empower / 2530.08); empower *= addtwo; \n\t\t\t\tinputSampleR += (empower / 224985.6); empower *= addtwo; \n\t\t\t\tinputSampleR -= (empower / 9979200.0);\n\t\t\t\t\n\t\t\t\tinputSampleR += dryCompR*invDry*(1.0-(bezComp[bez_comp]*(1.0-invDry)));\n\t\t\t}\n\t\t} \n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\t\tif (unsigned32(fpdL-fpdR) < 1073741824 || unsigned32(fpdR-fpdL) < 1073741824) {\n\t\t\tfpdR = advanceRandom(fpdR);}