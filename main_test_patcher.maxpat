\tbip[bip_drbRD] = bip[bip_praRC]-bip[bip_drbRC]; bip[bip_praRC] = bip[bip_drbRC];\n\t\t\t\tlet bip_drbE = bip[bip_praRD]-bip[bip_drbRD]; bip[bip_praRD] = bip[bip_drbRD];\n\t\t\t\tinputSampleR *= (1.0+(abs(bip[bip_drbRC])*0.0618)+(abs(bip[bip_drbRD])*-0.05982)+(abs(bip_drbE)*0.0206));\n\t\t\t}\n\t\t\tinputSampleR -= rbSampleRA*0.92;\n\t\t} else {\n\t\t\trbSampleRB = (rbSampleRB * (1.0-(rbAmount*dielectricScale)))+(inputSampleR*rbAmount*dielectricScale);\n\t\t\tif (abs(rbSampleRB)>1.18e-37) {\n\t\t\t\tlet bip_delta = inputSampleR; \n\t\t\t\tinputSampleR *= rbSampleRB*0.96;\n\t\t\t\tinputSampleR = multiplyAdd(((inputSampleR*inputSampleR) * -0.166666666666666),(inputSampleR*inputSampleR),inputSampleR);\n\t\t\t\tinputSampleR /= rbSampleRB*0.96;\n\t\t\t\tbip[bip_drbRA] = bip_delta - inputSampleR; \n\t\t\t\tbip[bip_drbRB] = bip[bip_prbRA]-bip[bip_drbRA]; bip[bip_prbRA] = bip[bip_drbRA];\n\t\t\t\tbip[bip_drbRC] = bip[bip_prbRB]-bip[bip_drbRB]; bip[bip_prbRB] = bip[bip_drbRB];\n\t\t\t\tbip[bip_drbRD] = bip[bip_prbRC]-bip[bip_drbRC]; bip[bip_prbRC] = bip[bip_drbRC];\n\t\t\t\tlet bip_drbE = bip[bip_prbRD]-bip[bip_drbRD]; bip[bip_prbRD] = bip[bip_drbRD];\n\t\t\t\tinputSampleR *= (1.0+(abs(bip[bip_drbRC])*0.0618)+(abs(bip[bip_drbRD])*-0.05982)+(abs(bip_drbE)*0.0206));\n\t\t\t}\n\t\t\tinputSampleR -= rbSampleRB*0.92;\n\t\t}\n\n\t\tlet bip_delta = inputSampleL; \n\t\tlet drySample = inputSampleL;\n\t\tinputSampleL = maximum(minimum(inputSampleL,1.0),-1.0);\n\t\tlet phatSample = inputSampleL * 1.57079633; \n\t\tlet X = phatSample; X *= X; \n\t\tlet temp = phatSample * X; \n\t\tphatSample -= temp*0.16666666666666666666666666666666666; temp *= X;\n\t\tphatSample += temp*0.00833333333333333333333333333333333; temp *= X;\n\t\tphatSample -= temp*0.00019841269841269841269841269841269; temp *= X;\n\t\tphatSample += temp*0.00000275573192239858906525573192239; temp *= X;\n\t\tphatSample -= temp*0.00000002505210838544171877521083854; temp *= X;\n\t\tphatSample += temp*0.00000000016059043836