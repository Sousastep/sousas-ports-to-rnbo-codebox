R = new FixedFloat64Array(d4P+5);\n@state g4AL = 0;\n@state g4BL = 0;\n@state g4CL = 0;\n@state g4DL = 0;\n@state g4DR = 0;\n@state g4HR = 0;\n@state g4LR = 0;\n@state g4PR = 0;\n@state bez = new FixedFloat64Array(bez_total);\n@state bezF = new FixedFloat64Array(bez_total);\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state reg4n = 0;\n@state attenuate = 0;\n@state derez = 0;\n@state bezFraction: Int = 0;\n@state bezTrim = 0;\n@state derezFreq = 0;\n@state bezFreqFraction: Int = 0;\n@state bezFreqTrim = 0;\n@state wider = 0;\n@state wet = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor(let x: Int = 0; x < d4A+2; x++) {a4AL[x] = 0.0; a4AR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4B+2; x++) {a4BL[x] = 0.0; a4BR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4C+2; x++) {a4CL[x] = 0.0; a4CR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4D+2; x++) {a4DL[x] = 0.0; a4DR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4E+2; x++) {a4EL[x] = 0.0; a4ER[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4F+2; x++) {a4FL[x] = 0.0; a4FR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4G+2; x++) {a4GL[x] = 0.0; a4GR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4H+2; x++) {a4HL[x] = 0.0; a4HR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4I+2; x++) {a4IL[x] = 0.0; a4IR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4J+2; x++) {a4JL[x] = 0.0; a4JR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4K+2; x++) {a4KL[x] = 0.0; a4KR[x] = 0.0;}\n\tfor(let x: Int = 0; x < d4L+2; x++) {a4LL[x] = 