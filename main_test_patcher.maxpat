                                        "safemath": 1,
                                        "code": "/* TakeCare — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Speed\n@param({ min: 0, max: 1 }) p_speed = 0.15;\n// VST B: Rando\n@param({ min: 0, max: 1 }) p_rando = 0.5;\n// VST C: Depth\n@param({ min: 0, max: 1 }) p_depth = 0.5;\n// VST D: Regen\n@param({ min: 0, max: 1 }) p_regen = 0.5;\n// VST E: Derez\n@param({ min: 0, max: 1 }) p_derez = 0.5;\n// VST F: Buffer\n@param({ min: 0, max: 1 }) p_buffer = 0.5;\n// VST G: Output\n@param({ min: 0, max: 1 }) p_output = 1.0;\n// VST H: Dry/Wet\n@param({ min: 0, max: 1 }) p_drywet = 1.0;\n\nconst bez_AL = 0;\nconst bez_AR = 1;\nconst bez_BL = 2;\nconst bez_BR = 3;\nconst bez_CL = 4;\nconst bez_CR = 5;\nconst bez_InL = 6;\nconst bez_InR = 7;\nconst bez_UnInL = 8;\nconst bez_UnInR = 9;\nconst bez_SampL = 10;\nconst bez_SampR = 11;\nconst bez_AvgInSampL = 12;\nconst bez_AvgInSampR = 13;\nconst bez_AvgOutSampL = 14;\nconst bez_AvgOutSampR = 15;\nconst bez_cycle = 16;\nconst bez_total = 17;\n@state a3AL = new FixedFloat64Array(32767+5);\n@state a3BL = new FixedFloat64Array(32767+5);\n@state a3CL = new FixedFloat64Array(32767+5);\n@state a3DL = new FixedFloat64Array(32767+5);\n@state a3EL = new FixedFloat64Array(32767+5);\n@state a3FL = new FixedFloat64Array(32767+5);\n@state a3GL = new FixedFloat64Array(32767+5);\n@state a3HL = new FixedFloat64Array(32767+5);\n@state a3IL = new FixedFloat64Array(32767+5);\n@state a3AR = new FixedFloat64Array(32767+5);\n@state a3BR = new FixedFloat64Array(32767+5);\n@state a3CR = new FixedFloat64Array(32767+5);\n@state a3DR = new FixedFloat64Array(32767+5);\n@state a3ER = new FixedFloat64Array(32767+5);\n@state a3FR = new FixedFloat64Array(32767+5);\n@state a3GR = new FixedFloat64Array(32767+5);\n@state a3HR = new FixedFloat64Array(32767+5);\n@state a3IR = new FixedFloat64Array(32767+5);\n@state c3AL: Int = 0;\n@state c3AR: Int = 0;\n@state c3BL: Int = 0;\n@state c3BR: Int = 0;\n@state c3CL: Int = 0;\n@state c3CR: Int = 0;\n@state c3DL: Int = 0;\n@state c3DR: Int = 0;\n@state c3EL: Int = 0;\n@state c3ER: Int = 0;\n@state c3FL: Int = 0;\n@state c3FR: Int = 0;\n@state c3GL: Int = 0;\n@state c3GR: Int = 0;\n@state c3HL: Int = 0;\n@state c3HR: Int = 0;\n@state c3IL: Int = 0;\n@state c3IR: Int = 0;\n@state f3AL = 0;\n@state f3BL = 0;\n@state f3CL = 0;\n@state f3CR = 0;\n@state f3FR = 0;\n@state f3IR = 0;\n@state avg3L = 0;\n@state avg3R = 0;\n@state bez = new FixedFloat64Array(bez_total);\n@state rotate = 0;\n@state oldfpd = 0;\n@state buf: Int = 0;\n@state vibDepth = 0;\n@state derezA = 0;\n@state derezB = 0;\n@state outA = 0;\n@state outB = 0;\n@state wetA = 