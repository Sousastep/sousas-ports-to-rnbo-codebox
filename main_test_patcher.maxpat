_pvRD = 15;\nconst bip_drbLA = 16;\nconst bip_drbLB = 17;\nconst bip_drbLC = 18;\nconst bip_drbLD = 19;\nconst bip_praLA = 20;\nconst bip_praLB = 21;\nconst bip_praLC = 22;\nconst bip_praLD = 23;\nconst bip_prbLA = 24;\nconst bip_prbLB = 25;\nconst bip_prbLC = 26;\nconst bip_prbLD = 27;\nconst bip_drbRA = 28;\nconst bip_drbRB = 29;\nconst bip_drbRC = 30;\nconst bip_drbRD = 31;\nconst bip_praRA = 32;\nconst bip_praRB = 33;\nconst bip_praRC = 34;\nconst bip_praRD = 35;\nconst bip_prbRA = 36;\nconst bip_prbRB = 37;\nconst bip_prbRC = 38;\nconst bip_prbRD = 39;\nconst bip_total = 40;\n@state rbSampleLA = 0;\n@state rbSampleRA = 0;\n@state rbSampleLB = 0;\n@state rbSampleRB = 0;\n@state lastSampleLA = 0;\n@state lastSampleLB = 0;\n@state lastSampleLC = 0;\n@state lastSampleRA = 0;\n@state lastSampleRB = 0;\n@state lastSampleRC = 0;\n@state flip = 0;\n@state bip = new FixedFloat64Array(bip_total);\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state density = 0;\n@state phattity = 0;\n@state nonLin = 0;\n@state output = 0;\n@state rbAmount = 0;\n@state threshold = 0;\n@state consoleType: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\n// RNBO has no fused multiply-add operator; preserve the equation.\nfunction multiplyAdd(a, b, c) { return a * b + c; }\n\nfunction init() {\n\n\trbSampleLA = 0.0;\n\trbSampleRA = 0.0;\n\trbSampleLB = 0.0;\n\trbSampleRB = 0.0;\n\tlastSampleLA = lastSampleLB = lastSampleLC = 0.0;\n\tlastSampleRA = lastSampleRB = lastSampleRC = 0.0;\n\tflip = 0;\n\tfor (let x: Int = 0; x < bip_total; x++) bip[x] = 0.0;\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\t\n\tdensity = p_drive*2.0; \n\tphattity = density - 1.0;\n\tif (density > 1.0) density = 1.0; \n\tif (phattity < 0.0) phattity = 0.0; \n\tnonLin = 5.0-density; \n\toutput = p_output;\n\trbAmount = 0.005832;\n\tthreshold = 0.33362176; \n\tconsoleType = trunc(p_consoletype * 4.999);\n switch (consoleType)\n\t{\n\t\tcase 0: rbAmount = 0.005832; threshold = 0.33362176; break; \n\t\tcase 1: rbAmount = 0.004096; threshold = 0.59969536; break; \n\t\tcase 2: rbAmount = 0.004913; threshold = 0.84934656; break; \n\t\tcase 3: rbAmount = 0.009216; threshold = 0.149; break; \n\t\tcase 4: rbAmount = 0.011449; threshold = 0.092; break; \n\t}\n\trbAmount /= overallscale; \n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tlet dielectricScale = abs(2.0-((inputSampleL+nonLin)/nonLin));\n\t\tif (flip) {\n\t\t\trbSampleLA = (rbSampleLA * (1.0-(rbAmount*dielectricScale)))+(inputSampleL*rbAmount*dielectricScale);\n\t\t\tif (abs(rbSampleLA)>1.18e-37) {\n\t\t\t\tlet bip_delta = inputSampleL; \n\t\t\t\tinputSampleL *= rbSampleLA*0.96;\n\t\t\t\tinputSampleL = multiplyAdd(((inputSampleL*inputSampleL) * -0.166666666666666),(inputSampleL*inputSampleL),inputSampleL);\n\t\t\t\tinputSampleL /= rbSampleLA*0.96;\n\t\t\t\tbip[bip_drbLA] = bip_delta - inputSampleL; \n\t\t\t\tbip[bip_drbLB] = bip[bip_praLA]-bip[bip_drbLA]; bip[bip_praLA] = bip[bip_drbLA];\n\t\t\t\tbip[bip_drbLC] = bip[bip_praLB]-bip[bip_drbLB]; bip[bip_praLB] = bip[bip_drbLB];\n\t\t\t\tbip[bip_drbLD] = bip[bip_praLC]-bip[bip_drbLC]; bip[bip_