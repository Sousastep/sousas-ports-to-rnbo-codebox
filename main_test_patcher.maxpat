                        "boxes": [
                            {
                                "box": {
                                    "code": "/* mrelwood_Sky_is_the_limit_3v2_BETA — RNBO codebox~ port of mrelwood source.\n * Stereo in1/in2 -> out1/out2; original slider units and defaults.\n * Graphics and GUI meters omitted. See RNBO/README.md and VALIDATION.md.\n * desc: Sky is the Limit 3.2 BETA [mrelwood]\n * \n * \n * \n */\n// Mid/Side\n@param({ min: 0, max: 1 }) slider1 = .2;\n// Link L/R, M/S\n@param({ min: 0, max: 1 }) slider2 = .2;\n// Tilt EQ (dB)\n@param({ min: -6, max: 6 }) slider5 = 0;\n// Pre Compression Punch\n@param({ min: 0, max: 1 }) slider6 = 0;\n// Pre Saturation\n@param({ min: 0, max: 1 }) slider7 = 0;\n// Limiter (Boost dB)\n@param({ min: 0, max: 30 }) slider10 = 0;\n// Safe vs Soft Clip\n@param({ min: 0, max: 1 }) slider11 = .2;\n// -Look ahead (~5 ms)\n@param({ min: 0, max: 1 }) slider51 = 0;\n// -Pre comp\n@param({ min: 0, max: 1 }) slider53 = 0;\n// Ceiling (dB)\n@param({ min: -18, max: 0 }) slider60 = -.1;\n// -Link Threshold & Volume\n@param({ min: 0, max: 1 }) slider62 = 0;\n@state ram = new FixedFloat64Array(1536);\n@state s_initialized = 0;\n@state frame: Int = 0;\n@state prepared = 0;\n@state s___safesoft = 0;\n@state s___safesoft1 = 0;\n@state s___safesoftdb = 0;\n@state s_ac = 0;\n@state s_bufsz = 0;\n@state s_cb0a0 = 0;\n@state s_ceiling = 0;\n@state s_comp1 = 0;\n@state s_compL_dirc = 0;\n@state s_compL_g = 0;\n@state s_compL_gdb = 0;\n@state s_compL_gv = 0;\n@state s_compL_ina = 0;\n@state s_compL_out = 0;\n@state s_compL_ovr = 0;\n@state s_compL_pk = 0;\n@state s_compL_pkdb = 0;\n@state s_compL_pkdir = 0;\n@state s_compL_pkdirf = 0;\n@state s_compL_pkdirfin = 0;\n@state s_compL_pko = 0;\n@state s_compL_prc = 0;\n@state s_compL_rc = 0;\n@state s_compL_tgtdb = 0;\n@state s_compM_dirc = 0;\n@state s_compM_gdb = 0;\n@state s_compM_gv = 0;\n@state s_compM_ina = 0;\n@state s_compM_out = 0;\n@state s_compM_ovr = 0;\n@state s_compM_pk = 0;\n@state s_compM_pkdb = 0;\n@state s_compM_pkdir = 0;\n@state s_compM_pkdirf = 0;\n@state s_co