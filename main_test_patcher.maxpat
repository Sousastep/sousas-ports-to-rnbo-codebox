rQ[(cQ+1)-((cQ+1 > dpQ)?dpQ+1:0)]*0.5));\n\t\t\toRR = asFloat32(oSR - (rR[(cR+1)-((cR+1 > dpR)?dpR+1:0)]*0.5));\n\t\t\toSR = asFloat32(oTR - (rS[(cS+1)-((cS+1 > dpS)?dpS+1:0)]*0.5));\n\t\t\toTR = asFloat32(inputSampleR); \n\t\t\tlQ[cQ] = oQL; lR[cR] = oRL; lS[cS] = oSL; lT[cT] = oTL;\n\t\t\trQ[cQ] = oQR; rR[cR] = oRR; rS[cS] = oSR; rT[cT] = oTR;\n\t\t\tcQ++; cR++; cS++; cT++;\n\t\t\tif (cQ > dpQ) cQ = 0;\n\t\t\tif (cR > dpR) cR = 0;\n\t\t\tif (cS > dpS) cS = 0;\n\t\t\tif (cT > dpT) cT = 0;\n\t\t\toQL = asFloat32(multiplyAdd(oQL,0.5,lQ[cQ]));\n\t\t\toRL = asFloat32(multiplyAdd(oRL,0.5,lR[cR]));\n\t\t\toSL = asFloat32(multiplyAdd(oSL,0.5,lS[cS]));\n\t\t\toTL = asFloat32(multiplyAdd(oTL,0.0,lT[cT])); \n\t\t\toQR = asFloat32(multiplyAdd(oQR,0.5,rQ[cQ]));\n\t\t\toRR = asFloat32(multiplyAdd(oRR,0.5,rR[cR]));\n\t\t\toSR = asFloat32(multiplyAdd(oSR,0.5,rS[cS]));\n\t\t\toTR = asFloat32(multiplyAdd(oTR,0.0,rT[cT])); \n\t\t\t\n\t\t\tif (bypassPre) {oQL = asFloat32(inputSampleL); oQR = asFloat32(inputSampleR);} \n\t\t\t\n\t\t\tlA[cA] = multiplyAdd(fAL,damping,oQL);\n\t\t\tlB[cB] = multiplyAdd(fBL,damping,oQL);\n\t\t\tlC[cC] = multiplyAdd(fCL,damping,oQL);\n\t\t\tlD[cD] = multiplyAdd(fDL,damping,oQL);\n\t\t\trA[cA] = multiplyAdd(fAR,damping,oQR);\n\t\t\trB[cB] = multiplyAdd(fBR,damping,oQR);\n\t\t\trC[cC] = multiplyAdd(fCR,damping,oQR);\n\t\t\trD[cD] = multiplyAdd(fDR,damping,oQR);\n\t\t\tcA++; cB++; cC++; cD++;\n\t\t\tif (cA > d4A) cA = 0;\n\t\t\tif (cB > d4B) cB = 0;\n\t\t\tif (cC > d4C) cC = 0;\n\t\t\tif (cD > d4D) cD = 0;\n\t\t\thAL = asFloat32(lA[cA]); hBL = asFloat32(lB[cB]); hCL = asFloat32(lC[cC]); hDL = asFloat32(lD[cD]);\n\t\t\thAR = asFloat32(rA[cA]); hBR = asFloat32(rB[cB]); hCR = asFloat32(rC[cC]); hDR = asFloat32(rD[cD]);\n\t\t\thEL = asFloat32(-(hAL + hBL + hCL + hDL));\n\t\t\thER = asFloat32(-(hAR + hBR + hCR + hDR));\n\t\t\tlE[cE] = multiplyAdd(hAL,2.0,hEL);\n\t\t\tlF[cF] = multiplyAdd(hBL,2.0,hEL);\n\t\t\tlG[cG] = multiplyAdd(hCL,2.0,hEL);\n\t\t\tlH[cH] = multi