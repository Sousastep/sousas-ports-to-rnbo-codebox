                                        "code": "/* ChannelX — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Console Type\n@param({ min: 0, max: 1 }) p_consoletype = 0.0;\n// VST B: Drive\n@param({ min: 0, max: 1 }) p_drive = 0.0;\n// VST C: Output\n@param({ min: 0, max: 1 }) p_output = 1.0;\n\nconst bip_dvLA = 0;\nconst bip_dvLB = 1;\nconst bip_dvLC = 2;\nconst bip_dvLD = 3;\nconst bip_pvLA = 4;\nconst bip_pvLB = 5;\nconst bip_pvLC = 6;\nconst bip_pvLD = 7;\nconst bip_dvRA = 8;\nconst bip_dvRB = 9;\nconst bip_dvRC = 10;\nconst bip_dvRD = 11;\nconst bip_pvRA = 12;\nconst bip_pvRB = 13;\nconst bip_pvRC = 14;\nconst bip_pvRD = 15;\nconst bip_drbLA = 16;\nconst bip_drbLB = 17;\nconst bip_drbLC = 18;\nconst bip_drbLD = 19;\nconst bip_praLA = 20;\nconst bip_praLB = 21;\nconst bip_praLC = 22;\nconst bip_praLD = 23;\nconst bip_prbLA = 24;\nconst bip_prbLB = 25;\nconst bip_prbLC = 26;\nconst bip_prbLD = 27;\nconst bip_drbRA = 28;\nconst bip_drbRB = 29;\nconst bip_drbRC = 30;\nconst bip_drbRD = 31;\nconst bip_praRA = 32;\nconst bip_praRB = 33;\nconst bip_praRC = 34;\nconst bip_praRD = 35;\nconst bip_prbRA = 36;\nconst bip_prbRB = 37;\nconst bip_prbRC = 38;\nconst bip_prbRD = 39;\nconst bip_total = 40;\n@state rbSampleLA = 0;\n@state rbSampleRA = 0;\n@state rbSampleLB = 0;\n@state rbSampleRB = 0;\n@state lastSampleLA = 0;\n@state lastSampleLB = 0;\n@state lastSampleLC = 0;\n@state lastSampleRA = 0;\n@state lastSampleRB = 0;\n@state lastSampleRC = 0;\n@state flip = 0;\n@state bip = new FixedFloat64Array(bip_total);\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state density = 0;\n@state phattity = 0;\n@state nonLin = 0;\n@state output = 0;\n@state rbAmount = 0;\n@state threshold = 0;\n@state consoleType: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\n// RNBO has no fused multiply-add operator; preserve the equation.\nfunction multiplyAdd(a, b, c) { return a * b + c; }\n\nfunction init() {\n\n\trbSampleLA = 0.0;\n\trbSampleRA = 0.0;\n\trbSampleLB = 0.0;\n\trbSampleRB = 0.0;\n\tlastSampleLA = lastSampleLB = lastSampleLC = 0.0;\n\tlastSampleRA = lastSampleRB = lastSampleRC = 0.0;\n\tflip = 0;\n\tfor (let x: Int = 0; x < bip_total; x++) bip[x] = 0.0;\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\t\n\tdensity = p_drive*2.0; \n\tphattity = density - 1.0;\n\tif (density > 1.0) density = 1.0; \n\tif (phattity < 0.0) phattity = 0.0; \n\tnonLin = 5.0-density; \n\toutput = p_output;\n\trbAmount = 0.005832;\n\tthreshold = 0.33362176; \n\tconsoleType = trunc(p_consoletype * 4.999);\n switch (consoleType)\n\t{\n\t\tcase 0: rbAmount = 0.005832; threshold = 0.33362176; break; \n\t\tcase 1: rbAmount = 0.004096; threshold = 0.59969536; break; \n\t\tcase 2: rbAmount = 0.004913; threshold = 0.84934656; break; \n\t\tcase 3: rbAmount = 0.009216; threshold = 0.149; break; \n\t\tcase 4: rbAmount = 0.011449; threshold = 0.092; break; \n\t}\n\trbAmount /= overallscale; \n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tlet dielectricScale = abs(2.0-((inputSampleL+nonLin)/nonLin));\n\t\tif (flip) {\n\t\t\trbSampleLA = (rbSampleLA * (1.0-(rbAmount*dielectricScale)))+(inputSampleL*rbAmount*dielectricScale);\n\t\t\tif (abs(rbSampleLA)>1.18e-37) {\n\t\t\t\tlet bip_delta = inputSampleL; \n\t\t\t\tinputSampleL *= rbSampleLA*0.96;\n\t\t\t\tinputSampleL = multiplyAdd(((inputSampleL*inputSampleL) * -0.166666666666666),(inputSampleL*inputSampleL),inputSampleL);\n\t\t\t\tinputSampleL /= rbSampleLA*0.96;\n\t\t\t\tbip[bip_drbLA] = bip_delta - inputSampleL; \n\t\t\t\tbip[bip_drbLB] = bip[bip_praLA]-bip[bip_drbLA]; bip[bip_praLA] = bip[bip_drbLA];\n\t\t\t\tbip[bip_drbLC] = bip[bip_praLB]-bip[bip_drbLB]; bip[bip_praLB] = bip[bip_drbLB];\n\t\t\t\tbip[bip_drbLD] = bip[bip_praLC]-bip[bip_drbLC]; bip[bip_praLC] = bip[bip_drbLC];\n\t\t\t\tlet bip_drbE = bip[bip_praLD]-bip[bip_drbLD]; bip[bip_praLD] = bip[bip_drbLD];\n\t\t\t\tinputSampleL *= (1.0+(abs(bip[bip_drbLC])*0.0618)+(abs(bip[bip_drbLD])*-0.05982)+(abs(bip_drbE)*0.0206));\n\t\t\t}\n\t\t\tinputSampleL -= rbSampleLA*0.92;\n\t\t} else {\n\t\t\trbSampleLB = (rbSampleLB * (1.0-(rbAmount*dielectricScale)))+(inputSampleL*rbAmount*dielectricScale);\n\t\t\tif (abs(rbSampleLB)>1.18e-37) {\n\t\t\t\tlet bip_delta = inputSampleL; \n\t\t\t\tinputSampleL *= rbSampleLB*0.96;\n\t\t\t\tinputSampleL = multiplyAdd(((inputSampleL*inputSampleL) * -0.166666666666666),(inputSampleL*inputSampleL),inputSampleL);\n\t\t\t\tinputSampleL /= rbSampleLB*0.96;\n\t\t\t\tbip[bip_drbLA] = bip_delta - inputSampleL; \n\t\t\t\tbip[bip_drbLB] = bip[bip_prbLA]-bip[bip_drbLA]; bip[bip_prbLA] = bip[bip_drbLA];\n\t\t\t\tbip[bip_drbLC] = bip[bip_prbLB]-bip[bip_drbLB]; bip[bip_prbLB] = bip[bip_drbLB];\n\t\t\t\tbip[bip_drbLD] = bip[bip_prbLC]-bip[bip_drbLC]; bip[bip_prbLC] = bip[bip_drbLC];\n\t\t\t\tlet bip_drbE = bip[bip_prbLD]-bip[bip_drbLD]; bip[bip_prbLD] = bip[bip_drbLD];\n\t\t\t\tinputSampleL *= (1.0+(abs(bip[bip_drbLC])*0.0618)+(abs(bip[bip_drbLD])*-0.05982)+(abs(bip_drbE)*0.0206));\n\t\t\t}\n\t\t\tinputSampleL -= rbSampleLB*0.92;\n\t\t}\n\n\t\tdielectricScale = abs(2.0-((inputSampleR+nonLin)/nonLin));\n\t\tif (flip) {\n\t\t\trbSampleRA = (rbSampleRA * (1.0-(rbAmount*dielectricScale)))+(inputSampleR*rbAmount*dielectricScale);\n\t\t\tif (abs(rbSampleRA)>1.18e-37) {\n\t\t\t\tlet bip_delta = inputSampleR; \n\t\t\t\tinputSampleR *= rbSampleRA*0.96;\n\t\t\t\tinputSampleR = multiplyAdd(((inputSampleR*inputSampleR) * -0.166666666666666),(inputSampleR*inputSampleR),inputSampleR);\n\t\t\t\tinputSampleR /= rbSampleRA*0.96;\n\t\t\t\tbip[bip_drbRA] = bip_delta - inputSampleR; \n\t\t\t\tbip[bip_drbRB] = bip[bip_praRA]-bip[bip_drbRA]; bip[bip_praRA] = bip[bip_drbRA];\n\t\t\t\tbip[bip_drbRC] = bip[bip_praRB]-bip[bip_drbRB]; bip[bip_praRB] = bip[bip_drbRB];\n\t\t\t\tbip[bip_drbRD] = bip[bip_praRC]-bip[bip_drbRC]; bip[bip_praRC] = bip[bip_drbRC];\n\t\t\t\tlet bip_drbE = bip[bip_praRD]-bip[bip_drbRD]; bip[bip_praRD] = bip[bip_drbRD];\n\t\t\t\tinputSampleR *= (1.0+(abs(bip[bip_drbRC])*0.0618)+(abs(bip[bip_drbRD])*-0.05982)+(abs(bip_drbE)*0.0206));\n\t\t\t}\n\t\t\tinputSampleR -= rbSampleRA*0.92;\n\t\t} else {\n\t\t\trbSampleRB = (rbSampleRB * (1.0-(rbAmount*dielectricScale)))+(inputSampleR*rbAmount*dielectricScale);\n\t\t\tif (abs(rbSampleRB)>1.18e-37) {\n\t\t\t\tlet bip_delta = inputSampleR; \n\t\t\t\tinputSampleR *= rbSampleRB*0.96;\n\t\t\t\tinputSampleR = multiplyAdd(((inputSampleR*inputSampleR) * -0.166666666666666),(inputSampleR*inputSampleR),inputSampleR);\n\t\t\t\tinputSampleR /= rbSampleRB*0.96;\n\t\t\t\tbip[bip_drbRA] = bip_delta - inputSampleR; \n\t\t\t\tbip[bip_drbRB] = bip[bip_prbRA]-bip[bip_drbRA]; bip[bip_prbRA] = bip[bip_drbRA];\n\t\t\t\tbip[bip_drbRC] = bip[bip_prbRB]-bip[bip_drbRB]; bip[bip_prbRB] = bip[bip_drbRB];\n\t\t\t\tbip[bip_drbRD] = bip[bip_prbRC]-bip[bip_drbRC]; bip[bip_prbRC] = bip[bip_drbRC];\n\t\t\t\tlet bip_drbE = bip[bip_prbRD]-bip[bip_drbRD]; bip[bip_prbRD] = bip[bip_drbRD];\n\t\t\t\tinputSampleR *= (1.0+(abs(bip[bip_drbRC])*0.0618)+(abs(bip[bip_drbRD])*-0.05982)+(abs(bip_drbE)*0.0206));\n\t\t\t}\n\t\t\tinputSampleR -= rbSampleRB*0.92;\n\t\t}\n\n\t\tlet bip_delta = inputSampleL; \n\t\tlet drySample = inputSampleL;\n\t\tinputSampleL = maximum(minimum(inputSampleL,1.0),-1.0);\n\t\tlet phatSample = inputSampleL * 1.57079633; \n\t\tlet X = phatSample; X *= X; \n\t\tlet temp = phatSample * X; \n\t\tphatSample -= temp*0.16666666666666666666666666666666666; temp *= X;\n\t\tphatSample += temp*0.00833333333333333333333333333333333; temp *= X;\n\t\tphatSample -= temp*0.00019841269841269841269841269841269; temp *= X;\n\t\tphatSample += temp*0.00000275573192239858906525573192239; temp *= X;\n\t\tphatSample -= temp*0.00000002505210838544171877521083854; temp *= X;\n\t\tphatSample += temp*0.0000000001605904