                        "classnamespace": "rnbo",
                        "rect": [ 184.0, 231.0, 1000.0, 780.0 ],
                        "default_fontname": "Lato",
                        "title": "untitled",
                        "boxes": [
                            {
                                "box": {
                                    "code": "/* ZAcidLowpass — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Cutoff\n@param({ min: 0, max: 1 }) p_cutoff = 0.5;\n// VST B: Over\n@param({ min: 0, max: 1 }) p_over = 0.0;\n// VST C: Under\n@param({ min: 0, max: 1 }) p_under = 1.0;\n// VST D: Meltdwn\n@param({ min: 0, max: 1 }) p_meltdwn = 0.0;\n// VST E: Drive\n@param({ min: 0, max: 1 }) p_drive = 0.1;\n// VST F: Output\n@param({ min: 0, max: 1 }) p_output = 1.0;\n\nconst bez_AL = 0;\nconst bez_AR = 1;\nconst bez_BL = 2;\nconst bez_BR = 3;\nconst bez_CL = 4;\nconst bez_CR = 5;\nconst bez_DL = 6;\nconst bez_DR = 7;\nconst bez_SampL = 8;\nconst bez_SampR = 9;\nconst bez_cycle = 10;\nconst bez_total = 11;\n@state bezA = new FixedFloat64Array(bez_total);\n@state biquadE = new FixedFloat64Array(15);\n@state biquadF = new FixedFloat64Array(15);\n@state iirSampleAL = 0;\n@state iirSampleAR = 0;\n@state cutoffA = 0;\n@state cutoffB = 0;\n@state overA = 0;\n@state overB = 0;\n@state underA = 0;\n@state underB = 0;\n@state meltdownA = 0;\n@state meltdownB = 0;\n@state inTrimA = 0;\n@state inTrimB = 0;\n@state outTrimA = 0;\n@state outTrimB = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state iirAmountA = 0;\n@state K = 0;\n@state norm = 0;\n@state x: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor (let x: Int = 0; x < bez_total; x++) {bezA[x] = 0.0;}\n\tbezA[bez_cycle] = 1.0;\n\tfor (let x: Int = 0; x < 15; x++) {biquadE[x] = 0.0; biquadF[x] = 0.0;}\n\tiirSampleAL = 0.0;\n\tiirSampleAR = 0.0;\n\n\tcutoffA = 0.5; cutoffB = 0.5;\n\toverA = 0.0; overB = 0.0;\n\tunderA = 1.0; underB = 1.0;\n\tmeltdownA = 0.0; meltdownB = 0.0;\n\tinTrimA = 0.1; inTrimB = 0.1;\n\toutTrimA = 1.0; outTrimB = 1.0;\t\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\t\n\tcutoffA = cutoffB;\n\tcutoffB = pow(p_cutoff,3.0)/overallscale;\n\tcutoffB /= (2.0/pow(overallscale,0.5-((overallscale-1.0)*0.0375)));\n\tif (cutoffB < 0.0001) cutoffB = 0.0001; if (cutoffB > 1.0) cutoffB = 1.0;\n\toverA = overB;\n\toverB = p_over;\n\tunderA = underB;\n\tunderB = p_under;\n\tmeltdownA = meltdownB;\n\tmeltdownB = p_meltdwn;\n\n\tinTrimA = inTrimB;\n\tinTrimB = p_drive*10.0;\n\tinTrimB *= inTrimB; inTrimB *= inTrimB;\n\toutTrimA = outTrimB;\n\toutTrimB = p_output;\n\t\n\tiirAmountA = 0.00069/overallscale;\n\tbiquadF[0] = biquadE[0] = 15500.0 / samplerate();\n    biquadF[1] = biquadE[1] = 0.935;\n\tK = tan(PI * biquadE[0]); \n\tnorm = 1.0 / (1.0 + K / biquadE[1] + K * K);\n\tbiquadE[2] = K * K * norm;\n\tbiquadE[3] = 2.0 * biquadE[2];\n\tbiquadE[4] = biquadE[2];\n\tbiquadE[5] = 2.0 * (K * K - 1.0) * norm;\n\tbiquadE[6] = (1.0 - K / biquadE[1] + K * K) * norm;\n\tfor (x = 0; x < 7; x++) biquadF[x] = biquadE[x];\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tlet temp = sampleFrames/inFramesToProcess;\n\t\tlet cutoff = (cutoffA*temp)+(cutoffB*(1.0-temp));\n\t\tlet over = (overA*temp)+(overB*(1.0-temp));\n\t\tlet under = (underA*temp)+(underB*(1.0-temp));\n\t\tlet meltdown = (meltdownA*temp)+(meltdownB*(1.0-temp));\n\t\tlet inTrim = (inTrimA*temp)+(inTrimB*(1.0-temp));\n\t\tlet outTrim = (outTrimA*temp)+(outTrimB*(1.0-temp));\n\t\tlet acidTrim = 1.0-pow(cutoff*0.5,1.0/(cutoff*0.5));\n\t\t\n\t\tbezA[bez_cycle] += cutoff;\n\t\tbezA[bez_SampL] += (inputSampleL * cutoff);\n\t\tbezA[bez_SampR] += (inputSampleR * cutoff);\n\t\t\n\t\tif (bezA[bez_cycle] > 1.0) { \n\t\t\tbezA[bez_cycle] -= 1.0;\n\t\t\tbezA[bez_DL] = bezA[bez_CL];\n\t\t\tbezA[bez_CL] = bezA[bez_BL];\n\t\t\tbezA[bez_BL] = bezA[bez_AL];\n\t\t\tbezA[bez_AL] = (bezA[bez_SampL]*(1.0-meltdown))+(inputSampleL*meltdown);\n\t\t\tbezA[bez_SampL] = 0.0;\n\t\t\tbezA[bez_DR] = bezA[bez_CR];\n\t\t\tbezA[bez_CR] = bezA[bez_BR];\n\t\t\tbezA[bez_BR] = bezA[bez_AR];\n\t\t\tbezA[bez_AR] = (bezA[bez_SampR]*(1.0-meltdown))+(inputSampleR*meltdown);\n\t\t\tbezA[bez_SampR] = 0.0;\n\t\t}\n\t\t\n\t\tlet X = bezA[bez_cycle]*acidTrim;\n\t\tlet midL = bezA[bez_DL] * pow(1.0-X,3.0);\n\t\tmidL += bezA[bez_CL] * 3.0 * pow(1.0-X,2.0) * X;\n\t\tmidL += bezA[bez_BL] * 3.0 * (1.0-X) * X * X;\n\t\tmidL += bezA[bez_AL] * pow(X,3.0);\n\t\tinputSampleL = (midL*under) + ((inputSampleL - midL)*over);\n\t\t\n\t\tlet midR = bezA[bez_DR] * pow(1.0-X,3.0);\n\t\tmidR += bezA[bez_CR] * 3.0 * pow(1.0-X,2.0) * X;\n\t\tmidR += bezA[bez_BR] * 3.0 * (1.0-X) * X * X;\n\t\tmidR += bezA[bez_AR] * pow(X,3.0);\n\t\tinputSampleR = (midR*under) + ((inputSampleR - midR)*over);\n\t\t\n\t\tif (inTrim != 1.0) {inputSampleL *= inTrim; inputSampleR *= inTrim;}\n\n\t\tif (abs(iirSampleAL)<1.18e-37) iirSampleAL = 0.0;\n\t\tiirSampleAL = (iirSampleAL * (1.0 - iirAmountA)) + (inputSampleL * iirAmountA);\n\t\tinputSampleL -= iirSampleAL;\n\t\tif (abs(iirSampleAR)<1.18e-37) iirSampleAR = 0.0;\n\t\tiirSampleAR = (iirSampleAR * (1.0 - iirAmountA)) + (inputSampleR * iirAmountA);\n\t\tinputSampleR -= iirSampleAR;\n\t\t\n\t\tlet outSample = biquadE[2]*inputSampleL+biquadE[3]*biquadE[7]+biquadE[4]*biquadE[8]-biquadE[5]*biquadE[9]-biquadE[6]*biquadE[10];\n\t\tbiquadE[8] = biquadE[7]; biquadE[7] = inputSampleL; inputSampleL = outSample; biquadE[10] = biquadE[9]; biquadE[9] = inputSampleL; \n\t\t\n\t\toutSample = biquadE[2]*inputSampleR+biquadE[3]*biquadE[11]+biquadE[4]*biquadE[12]-biquadE[5]*biquadE[13]-biquadE[6]*biquadE[14];\n\t\tbiquadE[12] = biquadE[11]; biquadE[11] = inputSampleR; inputSampleR = outSample; biquadE[14] = biquadE[13]; biquadE[13] = inputSampleR; \n\t\t\n\t\tif (inputSampleL > 1.0) inputSampleL = 1.0; if (inputSampleL < -1.0) inputSampleL = -1.0;\n\t\tinputSampleL -= (inputSampleL*inputSampleL*inputSampleL*inputSampleL*inputSampleL*0.1768);\n\t\tif (inputSampleR > 1.0) inputSampleR = 1.0; if (inputSampleR < -1.0) inputSampleR = -1.0;\n\t\tinputSampleR -= (inputSampleR*inputSampleR*inputSampleR*inputSampleR*inputSampleR*0.1768);\n\t\t\n\t\toutSample = biquadF[2]*inputSampleL+biquadF[3]*biquadF[7]+biquadF[4]*biquadF[8]-biquadF[5]*biquadF[9]-biquadF[6]*biquadF[10];\n\t\tbiquadF[8] = biquadF[7]; biquadF[7] = inputSampleL; inputSampleL = outSample; biquadF[10] = biquadF[9]; biquadF[9] = inputSampleL; \n\t\t\n\t\toutSample = biquadF[2]*inputSampleR+biquadF[3]*biquadF[11]+biquadF[4]*biquadF[12]-biquadF[5]*biquadF[13]-biquadF[6]*biquadF[14];\n\t\tbiquadF[12] = biquadF[11]; biquadF[11] = inputSampleR; inputSampleR = outSample; biquadF[14] = biquadF[13]; biquadF[13] = inputSampleR; \n\t\t\n\t\tif (outTrim != 1.0) {inputSampleL *= outTrim; inputSampleR *= outTrim;}\t\t\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\nout1 = inputSampleL;\nout2 = inputSampleR;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
                                    "fontsize": 12.0,
                                    "id": "obj-2",
                                    "maxclass": "codebox~",
                                    "numinlets": 2,
                                    "numoutlets": 2,
                                    "outlettype": [ "signal", "signal" ],
                                    "patching_rect": [ 30.0, 110.0, 620.0, 360.0 ],
                                    "rnbo_classname": "codebox~",
                                    "rnbo_extra_attributes": {
                                        "safemath": 1,
                                        "code": "/* ZAcidLowpass — standalone RNBO codebox~ port\n * in1/in2: left/right; out1/out2: left/right.\n * Controls use original normalized VST values (0..1).\n * Double-precision DSP path; no added output dither.\n * Paste this entire file into codebox~ inside rnbo~.\n * MIT License\n * \n * Copyright (c) 2018 Chris Johnson\n * \n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n * \n * The above copyright notice and this permission notice shall be included in all\n * copies or substantial portions of the Software.\n * \n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n * SOFTWARE.\n * \n */\n\n// VST A: Cutoff\n@param({ min: 0, max: 1 }) p_cutoff = 0.5;\n// VST B: Over\n@param({ min: 0, max: 1 }) p_over = 0.0;\n// VST C: Under\n@param({ min: 0, max: 1 }) p_under = 1.0;\n// VST D: Meltdwn\n@param({ min: 0, max: 1 }) p_meltdwn = 0.0;\n// VST E: Drive\n@param({ min: 0, max: 1 }) p_drive = 0.1;\n// VST F: Output\n@param({ min: 0, max: 1 }) p_output = 1.0;\n\nconst bez_AL = 0;\nconst bez_AR = 1;\nconst bez_BL = 2;\nconst bez_BR = 3;\nconst bez_CL = 4;\nconst bez_CR = 5;\nconst bez_DL = 6;\nconst bez_DR = 7;\nconst bez_SampL = 8;\nconst bez_SampR = 9;\nconst bez_cycle = 10;\nconst bez_total = 11;\n@state bezA = new FixedFloat64Array(bez_total);\n@state biquadE = new FixedFloat64Array(15);\n@state biquadF = new FixedFloat64Array(15);\n@state iirSampleAL = 0;\n@state iirSampleAR = 0;\n@state cutoffA = 0;\n@state cutoffB = 0;\n@state overA = 0;\n@state overB = 0;\n@state underA = 0;\n@state underB = 0;\n@state meltdownA = 0;\n@state meltdownB = 0;\n@state inTrimA = 0;\n@state inTrimB = 0;\n@state outTrimA = 0;\n@state outTrimB = 0;\n@state fpdL = 305419896.0;\n@state fpdR = 2271560481.0;\n@state overallscale = 0;\n@state iirAmountA = 0;\n@state K = 0;\n@state norm = 0;\n@state x: Int = 0;\n@state frame: Int = 0;\n// Xorshift32 with explicit unsigned wrapping (fixed, reproducible seeds).\nfunction unsigned32(x) {\n    return x - floor(x / 4294967296.0) * 4294967296.0;\n}\nfunction advanceRandom(x) {\n    let a: Int = x;\n    let left: Int = unsigned32(x * 8192.0);\n    let b: Int = unsigned32(a ^ left);\n    let shifted: Int = floor(b / 131072.0);\n    let c: Int = unsigned32(b ^ shifted);\n    left = unsigned32(c * 32.0);\n    return unsigned32(c ^ left);\n}\nfunction toIndex(x) {\n    let result: Int = trunc(x);\n    return result;\n}\n\nfunction init() {\n\n\tfor (let x: Int = 0; x < bez_total; x++) {bezA[x] = 0.0;}\n\tbezA[bez_cycle] = 1.0;\n\tfor (let x: Int = 0; x < 15; x++) {biquadE[x] = 0.0; biquadF[x] = 0.0;}\n\tiirSampleAL = 0.0;\n\tiirSampleAR = 0.0;\n\n\tcutoffA = 0.5; cutoffB = 0.5;\n\toverA = 0.0; overB = 0.0;\n\tunderA = 1.0; underB = 1.0;\n\tmeltdownA = 0.0; meltdownB = 0.0;\n\tinTrimA = 0.1; inTrimB = 0.1;\n\toutTrimA = 1.0; outTrimB = 1.0;\t\n\n}\nfunction dspsetup() { frame = 0; }\n\nif (frame == 0) {\noverallscale = 1.0;\n\toverallscale /= 44100.0;\n\toverallscale *= samplerate();\n\t\n\tcutoffA = cutoffB;\n\tcutoffB = pow(p_cutoff,3.0)/overallscale;\n\tcutoffB /= (2.0/pow(overallscale,0.5-((overallscale-1.0)*0.0375)));\n\tif (cutoffB < 0.0001) cutoffB = 0.0001; if (cutoffB > 1.0) cutoffB = 1.0;\n\toverA = overB;\n\toverB = p_over;\n\tunderA = underB;\n\tunderB = p_under;\n\tmeltdownA = meltdownB;\n\tmeltdownB = p_meltdwn;\n\n\tinTrimA = inTrimB;\n\tinTrimB = p_drive*10.0;\n\tinTrimB *= inTrimB; inTrimB *= inTrimB;\n\toutTrimA = outTrimB;\n\toutTrimB = p_output;\n\t\n\tiirAmountA = 0.00069/overallscale;\n\tbiquadF[0] = biquadE[0] = 15500.0 / samplerate();\n    biquadF[1] = biquadE[1] = 0.935;\n\tK = tan(PI * biquadE[0]); \n\tnorm = 1.0 / (1.0 + K / biquadE[1] + K * K);\n\tbiquadE[2] = K * K * norm;\n\tbiquadE[3] = 2.0 * biquadE[2];\n\tbiquadE[4] = biquadE[2];\n\tbiquadE[5] = 2.0 * (K * K - 1.0) * norm;\n\tbiquadE[6] = (1.0 - K / biquadE[1] + K * K) * norm;\n\tfor (x = 0; x < 7; x++) biquadF[x] = biquadE[x];\n\n}\nlet sampleFrames = vectorsize() - frame - 1;\nlet inFramesToProcess = vectorsize();\n\n\t\tlet inputSampleL = in1;\n\t\tlet inputSampleR = in2;\n\t\tif (abs(inputSampleL)<1.18e-23) inputSampleL = fpdL * 1.18e-17;\n\t\tif (abs(inputSampleR)<1.18e-23) inputSampleR = fpdR * 1.18e-17;\n\t\t\n\t\tlet temp = sampleFrames/inFramesToProcess;\n\t\tlet cutoff = (cutoffA*temp)+(cutoffB*(1.0-temp));\n\t\tlet over = (overA*temp)+(overB*(1.0-temp));\n\t\tlet under = (underA*temp)+(underB*(1.0-temp));\n\t\tlet meltdown = (meltdownA*temp)+(meltdownB*(1.0-temp));\n\t\tlet inTrim = (inTrimA*temp)+(inTrimB*(1.0-temp));\n\t\tlet outTrim = (outTrimA*temp)+(outTrimB*(1.0-temp));\n\t\tlet acidTrim = 1.0-pow(cutoff*0.5,1.0/(cutoff*0.5));\n\t\t\n\t\tbezA[bez_cycle] += cutoff;\n\t\tbezA[bez_SampL] += (inputSampleL * cutoff);\n\t\tbezA[bez_SampR] += (inputSampleR * cutoff);\n\t\t\n\t\tif (bezA[bez_cycle] > 1.0) { \n\t\t\tbezA[bez_cycle] -= 1.0;\n\t\t\tbezA[bez_DL] = bezA[bez_CL];\n\t\t\tbezA[bez_CL] = bezA[bez_BL];\n\t\t\tbezA[bez_BL] = bezA[bez_AL];\n\t\t\tbezA[bez_AL] = (bezA[bez_SampL]*(1.0-meltdown))+(inputSampleL*meltdown);\n\t\t\tbezA[bez_SampL] = 0.0;\n\t\t\tbezA[bez_DR] = bezA[bez_CR];\n\t\t\tbezA[bez_CR] = bezA[bez_BR];\n\t\t\tbezA[bez_BR] = bezA[bez_AR];\n\t\t\tbezA[bez_AR] = (bezA[bez_SampR]*(1.0-meltdown))+(inputSampleR*meltdown);\n\t\t\tbezA[bez_SampR] = 0.0;\n\t\t}\n\t\t\n\t\tlet X = bezA[bez_cycle]*acidTrim;\n\t\tlet midL = bezA[bez_DL] * pow(1.0-X,3.0);\n\t\tmidL += bezA[bez_CL] * 3.0 * pow(1.0-X,2.0) * X;\n\t\tmidL += bezA[bez_BL] * 3.0 * (1.0-X) * X * X;\n\t\tmidL += bezA[bez_AL] * pow(X,3.0);\n\t\tinputSampleL = (midL*under) + ((inputSampleL - midL)*over);\n\t\t\n\t\tlet midR = bezA[bez_DR] * pow(1.0-X,3.0);\n\t\tmidR += bezA[bez_CR] * 3.0 * pow(1.0-X,2.0) * X;\n\t\tmidR += bezA[bez_BR] * 3.0 * (1.0-X) * X * X;\n\t\tmidR += bezA[bez_AR] * pow(X,3.0);\n\t\tinputSampleR = (midR*under) + ((inputSampleR - midR)*over);\n\t\t\n\t\tif (inTrim != 1.0) {inputSampleL *= inTrim; inputSampleR *= inTrim;}\n\n\t\tif (abs(iirSampleAL)<1.18e-37) iirSampleAL = 0.0;\n\t\tiirSampleAL = (iirSampleAL * (1.0 - iirAmountA)) + (inputSampleL * iirAmountA);\n\t\tinputSampleL -= iirSampleAL;\n\t\tif (abs(iirSampleAR)<1.18e-37) iirSampleAR = 0.0;\n\t\tiirSampleAR = (iirSampleAR * (1.0 - iirAmountA)) + (inputSampleR * iirAmountA);\n\t\tinputSampleR -= iirSampleAR;\n\t\t\n\t\tlet outSample = biquadE[2]*inputSampleL+biquadE[3]*biquadE[7]+biquadE[4]*biquadE[8]-biquadE[5]*biquadE[9]-biquadE[6]*biquadE[10];\n\t\tbiquadE[8] = biquadE[7]; biquadE[7] = inputSampleL; inputSampleL = outSample; biquadE[10] = biquadE[9]; biquadE[9] = inputSampleL; \n\t\t\n\t\toutSample = biquadE[2]*inputSampleR+biquadE[3]*biquadE[11]+biquadE[4]*biquadE[12]-biquadE[5]*biquadE[13]-biquadE[6]*biquadE[14];\n\t\tbiquadE[12] = biquadE[11]; biquadE[11] = inputSampleR; inputSampleR = outSample; biquadE[14] = biquadE[13]; biquadE[13] = inputSampleR; \n\t\t\n\t\tif (inputSampleL > 1.0) inputSampleL = 1.0; if (inputSampleL < -1.0) inputSampleL = -1.0;\n\t\tinputSampleL -= (inputSampleL*inputSampleL*inputSampleL*inputSampleL*inputSampleL*0.1768);\n\t\tif (inputSampleR > 1.0) inputSampleR = 1.0; if (inputSampleR < -1.0) inputSampleR = -1.0;\n\t\tinputSampleR -= (inputSampleR*inputSampleR*inputSampleR*inputSampleR*inputSampleR*0.1768);\n\t\t\n\t\toutSample = biquadF[2]*inputSampleL+biquadF[3]*biquadF[7]+biquadF[4]*biquadF[8]-biquadF[5]*biquadF[9]-biquadF[6]*biquadF[10];\n\t\tbiquadF[8] = biquadF[7]; biquadF[7] = inputSampleL; inputSampleL = outSample; biquadF[10] = biquadF[9]; biquadF[9] = inputSampleL; \n\t\t\n\t\toutSample = biquadF[2]*inputSampleR+biquadF[3]*biquadF[11]+biquadF[4]*biquadF[12]-biquadF[5]*biquadF[13]-biquadF[6]*biquadF[14];\n\t\tbiquadF[12] = biquadF[11]; biquadF[11] = inputSampleR; inputSampleR = outSample; biquadF[14] = biquadF[13]; biquadF[13] = inputSampleR; \n\t\t\n\t\tif (outTrim != 1.0) {inputSampleL *= outTrim; inputSampleR *= outTrim;}\t\t\n\n\t\tfpdL = advanceRandom(fpdL);\n\n\t\tfpdR = advanceRandom(fpdR);\n\nout1 = inputSampleL;\nout2 = inputSampleR;\nframe++;\nif (frame >= vectorsize()) frame = 0;\n",
                                        "nocache": 0,
                                        "expr": ""
                                    },
                                    "rnbo_serial": 1,
                                    "rnbo_uniqueid": "effect_code",
